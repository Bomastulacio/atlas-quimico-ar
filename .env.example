# =============================================================================
# Atlas Químico y Productivo de Argentina — Variables de entorno
# Copiar a `.env` local (nunca commitear `.env` con claves reales).
# =============================================================================

# --- Supabase / PostgreSQL (fuente de verdad SQL + Storage privado para crudos) ---
# URL del proyecto y clave publishable (solo lectura vía RLS; nunca exponer service_role en frontend)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo para el pipeline offline Python (subir PDFs/CSVs crudos al bucket privado atlas-raw-sources)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=atlas-raw-sources

# --- Google Sheets (alternativa local/CSV) ---
# ID de la planilla de Google Sheets compartida en solo lectura.
# Ejemplo: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Opcional: si se usa exportación por URL pública de cada pestaña (GViz CSV),
# los nombres de pestañas esperados están documentados en docs/datos.md.
# Para probar sin red ni planilla, usar: npm run data:sync:example
DATA_STRICT_REAL=false

# --- Pipeline de Agentes LangGraph (Etapas 4 y 5, offline) ---
# Proveedor principal: Google Gemini API (respetando cuotas free tier)
GOOGLE_API_KEY=

# Modelos configurables por rol (nunca hardcodeados en código; familia Gemini 4, 1M tokens)
# Agente 1 (extracción/normalización): modelo rápido y balanceado
AGENT1_MODEL=gemini-4-hydrogen
# Agente 2 (procesos químicos): modelo de razonamiento eficiente
AGENT2_MODEL=gemini-4-argon
# Agente 3 (verificador independiente con contexto limpio): modelo de frontera
AGENT3_MODEL=gemini-4-neon

# Límites de seguridad, ventana de contexto y cuotas para uso gratuito controlado
PIPELINE_MAX_RETRIES_PER_STEP=2
PIPELINE_MAX_STEPS_PER_RUN=40
PIPELINE_MAX_LLM_CALLS=18
PIPELINE_MAX_RPM=5
PIPELINE_MAX_COST_USD=0.00
PIPELINE_MAX_SOURCE_CHARS=120000
PIPELINE_MAX_TOTAL_CONTEXT_CHARS=480000
PIPELINE_MAX_PDF_PAGE_CHARS=12000
PIPELINE_MAX_HTML_LINES=2000
PIPELINE_MAX_OUTPUT_TOKENS=16384

# Trazabilidad (Langfuse / OpenTelemetry / LangSmith)
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
