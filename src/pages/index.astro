---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DitheredAsciiArt } from '@/components/DitheredAsciiArt';
import { ProcessDeckPreview } from '@/components/ProcessDeckPreview';
import {
  getManifest,
  getProceso,
  getProductos,
  getResumenCobertura,
  isExampleDataset,
} from '@/data';

const manifest = getManifest();
const esEjemplo = isExampleDataset();
const productos = getProductos();
const cobertura = getResumenCobertura();
const procesoEjemplo = getProceso('aluminio-hall-heroult');
---

<BaseLayout title="Atlas Químico y Productivo de Argentina — Etapa 1">
  {/* Barra superior fija estilo galería técnica (details.so) */}
  <nav class="sticky top-0 z-30 border-b border-rule bg-canvas/95 backdrop-blur-xs">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3">
        <span class="inline-block h-2.5 w-2.5 bg-cobalt" aria-hidden="true" />
        <span class="font-display text-sm font-semibold tracking-tight text-ink">
          ATLAS QUÍMICO AR
        </span>
        <span class="hidden font-mono text-[11px] text-ink-muted sm:inline">
          / v{manifest.version_esquema}
        </span>
      </div>

      <div class="flex items-center gap-2 font-mono text-[11px]">
        {esEjemplo ? (
          <span class="inline-flex items-center gap-1.5 border border-ink bg-ink px-2.5 py-1 text-white">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-molten" />
            MODO EJEMPLO · ETAPA 1
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 border border-emerald-react bg-emerald-react/10 px-2.5 py-1 text-emerald-react">
            DATOS VALIDADOS
          </span>
        )}
      </div>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    {/* Hero asimétrico B&W con ruptura de color en el lienzo halftone/ASCII */}
    <header class="grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="flex flex-col justify-between space-y-6 lg:col-span-6">
        <div class="space-y-4">
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-ink-muted">
            Argentina · Procesos químicos · Comercio exterior
          </p>
          <h1 class="font-display text-4xl font-bold leading-[1.02] tracking-[-0.03em] text-ink sm:text-5xl lg:text-[3.4rem]">
            Qué produce Argentina, cómo se transforma y cuánto vale.
          </h1>
          <p class="max-w-xl text-base leading-relaxed text-ink-muted">
            Atlas interactivo de ingeniería de procesos e industria argentina. Cada cifra exige
            fuente oficial verificable, año, cita exacta y hash SHA-256. Sin estimaciones
            inventadas.
          </p>
        </div>

        {/* Métricas en grilla hairline B&W */}
        <dl class="grid grid-cols-2 gap-px border border-rule bg-rule font-mono tabular-nums sm:grid-cols-4">
          <div class="bg-canvas p-3.5">
            <dt class="text-[10px] uppercase text-ink-muted">Jurisdicciones</dt>
            <dd class="mt-1 text-xl font-semibold text-ink">{cobertura.totalProvincias}</dd>
          </div>
          <div class="bg-canvas p-3.5">
            <dt class="text-[10px] uppercase text-ink-muted">Cadenas MVP</dt>
            <dd class="mt-1 text-xl font-semibold text-ink">{productos.length}</dd>
          </div>
          <div class="bg-canvas p-3.5">
            <dt class="text-[10px] uppercase text-ink-muted">Tablas SQL</dt>
            <dd class="mt-1 text-xl font-semibold text-ink">
              {Object.keys(manifest.tablas).length}
            </dd>
          </div>
          <div class="bg-canvas p-3.5">
            <dt class="text-[10px] uppercase text-ink-muted">Deptos. polo</dt>
            <dd class="mt-1 text-xl font-semibold text-cobalt">
              {cobertura.departamentosConDatos}
            </dd>
          </div>
        </dl>

        {esEjemplo && (
          <div
            role="status"
            class="border-l-2 border-signal-red bg-surface px-4 py-3 font-mono text-xs text-ink"
          >
            <span class="font-semibold text-signal-red">AVISO DE ETAPA 1:</span> los registros
            cargados son ficticios (<code class="text-ink">confianza="ejemplo"</code>) para probar
            esquemas y pipeline. Sin datos oficiales hasta aprobar{' '}
            <code class="text-ink underline">docs/datos.md</code>.
          </div>
        )}
      </div>

      {/* Arte generativo halftone/ASCII con ruptura de color estilo Devault */}
      <div class="lg:col-span-6">
        <DitheredAsciiArt client:load initialScene="electrolisis" />
      </div>
    </header>

    {/* Consola interactiva Etapa 1 */}
    <main class="mt-12 space-y-10">
      <ProcessDeckPreview
        client:load
        productos={productos}
        procesoEjemplo={procesoEjemplo?.proceso ?? null}
        pasosEjemplo={procesoEjemplo?.pasos ?? []}
        esEjemplo={esEjemplo}
      />

      {/* Arquitectura de datos y hoja de ruta en bento B&W */}
      <section class="grid gap-6 lg:grid-cols-12">
        <div class="border border-rule bg-surface p-5 lg:col-span-7">
          <div class="flex items-center justify-between font-mono text-xs uppercase tracking-wider text-ink-muted">
            <span>[02] Trazabilidad de datos</span>
            <span class="text-ink">raw → staging → validated</span>
          </div>

          <div class="mt-4 grid gap-2 sm:grid-cols-4 font-mono text-xs">
            {[
              { step: '01', title: 'Sheets / Oficial', desc: '12 pestañas relacionales' },
              { step: '02', title: 'data/raw', desc: 'Descarga + SHA-256' },
              { step: '03', title: 'Zod + FKs', desc: 'Bloquea si falta cita' },
              { step: '04', title: 'src/data/', desc: 'Capa única Astro' },
            ].map((node, i) => (
              <div
                class={`border p-3 ${
                  i === 3 ? 'border-ink bg-ink text-white' : 'border-rule bg-canvas text-ink'
                }`}
              >
                <span class={`text-[10px] ${i === 3 ? 'text-cobalt bg-white px-1' : 'text-ink-muted'}`}>
                  {node.step}
                </span>
                <p class="mt-2 font-semibold">{node.title}</p>
                <p class={`mt-1 text-[11px] ${i === 3 ? 'text-white/75' : 'text-ink-muted'}`}>
                  {node.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="border border-rule bg-canvas p-5 lg:col-span-5">
          <p class="font-mono text-xs uppercase tracking-wider text-ink-muted">
            [03] Hoja de ruta
          </p>
          <ol class="mt-4 space-y-2.5 font-mono text-xs">
            <li class="flex items-baseline justify-between border-b border-rule pb-2 text-ink">
              <span>01 · Repo, esquema y capa src/data</span>
              <span class="bg-emerald-react px-1.5 py-0.5 text-[10px] font-semibold text-white">
                LISTO
              </span>
            </li>
            <li class="flex items-baseline justify-between border-b border-rule pb-2 text-ink">
              <span>02 · Mapa bicontinental IGN interactivo</span>
              <span class="bg-cobalt px-1.5 py-0.5 text-[10px] font-semibold text-white">
                SIGUIENTE
              </span>
            </li>
            <li class="flex items-baseline justify-between border-b border-rule pb-2 text-ink-muted">
              <span>03 · Aluminio (Chubut) a mano — Set de oro</span>
              <span>PENDIENTE</span>
            </li>
            <li class="flex items-baseline justify-between text-ink-muted">
              <span>04–05 · Pipeline LangGraph + verificación</span>
              <span>PENDIENTE</span>
            </li>
          </ol>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
