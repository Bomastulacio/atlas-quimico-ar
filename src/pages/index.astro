---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { ArgentinaMapExplorer } from '@/components/ArgentinaMapExplorer';
import { ProcessDeckPreview } from '@/components/ProcessDeckPreview';
import {
  getChainCardSummaries,
  getFichaProducto,
  getGeoAntartidaIslas,
  getGeoContinental,
  getGeoManifest,
  getMapaProvinciasData,
  getProductos,
  getSearchIndex,
  isExampleDataset,
} from '@/data';

const esEjemplo = isExampleDataset();
const productos = getProductos();
const productosValidados = productos.filter((p) => p.estado_mvp === 'validado');
const procesosVerificados = productosValidados
  .map((p) => getFichaProducto(p.producto_id)?.procesos[0] ?? null)
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const continentalGeo = getGeoContinental();
const antartidaIslasGeo = getGeoAntartidaIslas();
const geoManifest = getGeoManifest();
const provinciasData = getMapaProvinciasData();
const searchItems = getSearchIndex();
const chainSummaries = getChainCardSummaries();
---

<BaseLayout title="Atlas Químico Argentino">
  {/* Encabezado a ancho completo: transparente sobre el hero y piedra frosted al hacer scroll */}
  <SiteHeader client:load variant="hero" searchItems={searchItems} currentPath="/" />

  {/* Portada editorial a sangre desde y = 0 con fotografía industrial y espacio negativo para el titular */}
  <section
    aria-label="Presentación del Atlas Químico Argentino"
    class="relative flex min-h-[540px] items-center overflow-hidden bg-[#0D1117] text-white sm:min-h-[600px] lg:min-h-[650px]"
  >
    <img
      src="/images/hero-atlas-industria.jpg"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-90"
    />

    {/* Scrims suaves para lectura AAA del header y la tipografía sobre la fotografía */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0A0D12]/80 via-[#0A0D12]/15 to-[#0A0D12]/50"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#0A0D12]/90 via-[#0A0D12]/55 to-transparent"
    />

    <div class="relative z-10 mx-auto w-full max-w-[1600px] px-5 pb-24 pt-28 sm:px-8 sm:pb-32 sm:pt-32 lg:px-10 lg:pb-36 lg:pt-36">
      <div class="max-w-2xl">
        <h1 class="font-display text-[clamp(2.4rem,4.7vw,4.35rem)] font-bold leading-[1.03] tracking-[-0.035em] text-white">
          Mapa productivo
          <br />
          e industrial de
          <br />
          Argentina
        </h1>

        <p class="mt-5 max-w-[46ch] text-[15px] leading-relaxed text-white/80 sm:text-[17px]">
          Qué fabrica el país, qué procesos químicos transforman cada insumo y cuánto comercio
          exterior genera, con fuentes oficiales verificables en cada cifra.
        </p>

        <div class="mt-8 flex items-center gap-3">
          <a
            href="#mapa"
            class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-[15px] font-semibold text-ink transition-colors duration-150 hover:bg-stone-bg"
          >
            <span>Explorar mapa interactivo</span>
          </a>
          <a
            href="#mapa"
            aria-label="Desplazarse al mapa productivo interactivo"
            class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-white/85 transition-colors duration-150 hover:border-white/60 hover:text-white"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 5v14" />
              <path d="m19 12-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Hoja elevada del mapa productivo asomando sobre el cierre del hero */}
  <main class="relative z-20 mx-auto max-w-[1600px] px-5 pb-20 sm:px-8 lg:px-10">
    <section id="mapa" class="-mt-14 scroll-mt-24 sm:-mt-20">
      <ArgentinaMapExplorer
        client:load
        continentalGeo={continentalGeo}
        antartidaIslasGeo={antartidaIslasGeo}
        provinciasData={provinciasData}
        productos={productos}
        geoManifest={geoManifest}
        esEjemplo={esEjemplo}
      />
    </section>

    {/* Sección interactiva de cadenas y explorador paso a paso */}
    <section id="procesos" class="mt-20 scroll-mt-24">
      <ProcessDeckPreview
        client:load
        productos={productos}
        procesosVerificados={procesosVerificados}
        chainSummaries={chainSummaries}
        esEjemplo={esEjemplo}
      />
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Toda cifra exige año, organismo, URL y verificación de archivo; los
        faltantes se declaran sin datos.
      </p>
      <p class="tabular-nums">
        Límites provinciales: {geoManifest.organismo} ({geoManifest.fecha_descarga})
      </p>
    </div>
  </footer>
</BaseLayout>
