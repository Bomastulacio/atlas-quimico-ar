---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { ArgentinaMapExplorer } from '@/components/ArgentinaMapExplorer';
import { ProcessDeckPreview } from '@/components/ProcessDeckPreview';
import {
  getChainCardSummaries,
  getCoberturaDetallada,
  getEmpresasConPlantas,
  getFichaProducto,
  getGeoAntartidaIslas,
  getGeoContinental,
  getGeoDepartamentos,
  getGeoManifest,
  getMapaDepartamentosData,
  getMapaProvinciasData,
  getProductos,
  getSearchIndex,
  isExampleDataset,
} from '@/data';

const esEjemplo = isExampleDataset();
const productos = getProductos();
const productosValidados = productos.filter((p) => p.estado_mvp === 'validado');
const procesosVerificados = productosValidados
  .map((p) => getFichaProducto(p.producto_id)?.procesos[0] ?? null)
  .filter((p): p is NonNullable<typeof p> => Boolean(p));

const continentalGeo = getGeoContinental();
const antartidaIslasGeo = getGeoAntartidaIslas();
const departamentosGeo = getGeoDepartamentos();
const geoManifest = getGeoManifest();
const provinciasData = getMapaProvinciasData();
const departamentosData = getMapaDepartamentosData();
const searchItems = getSearchIndex();
const chainSummaries = getChainCardSummaries();
const empresasConPlantas = getEmpresasConPlantas();
const cobertura = getCoberturaDetallada();
const pctCobertura = Math.round(
  (cobertura.totales.provinciasConDatos / cobertura.totales.totalProvincias) * 100
);
---

<BaseLayout title="Atlas Químico Argentino">
  {/* Encabezado a ancho completo: transparente sobre el hero y piedra frosted al hacer scroll */}
  <SiteHeader client:load variant="hero" searchItems={searchItems} currentPath="/" />

  {/* Portada editorial a sangre desde y = 0 con fotografía industrial y espacio negativo para el titular */}
  <section
    aria-label="Presentación del Atlas Químico Argentino"
    class="relative flex min-h-[540px] items-center overflow-hidden bg-[#0D1117] text-white sm:min-h-[600px] lg:min-h-[650px]"
  >
    <img
      src="/images/hero-atlas-industria.jpg"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-90"
    />

    {/* Scrims suaves para lectura AAA del header y la tipografía sobre la fotografía */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#0A0D12]/80 via-[#0A0D12]/15 to-[#0A0D12]/50"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#0A0D12]/90 via-[#0A0D12]/55 to-transparent"
    />

    <div class="relative z-10 mx-auto w-full max-w-[1600px] px-5 pb-24 pt-28 sm:px-8 sm:pb-32 sm:pt-32 lg:px-10 lg:pb-36 lg:pt-36">
      <div class="max-w-2xl">
        <h1 class="font-display text-[clamp(2.35rem,4.5vw,4rem)] font-medium leading-[1.04] tracking-[-0.036em] text-white text-balance">
          Mapa productivo
          <br />
          e industrial de Argentina
        </h1>

        <p class="mt-5 max-w-[46ch] text-[15px] font-normal leading-relaxed text-white/80 sm:text-[16px]">
          Qué fabrica el país, qué procesos químicos transforman cada insumo y cuánto comercio
          exterior genera, con fuentes oficiales verificables en cada cifra.
        </p>

        <div class="mt-8">
          <a
            href="#mapa"
            class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-[14px] font-medium text-ink transition-colors duration-150 hover:bg-stone-bg"
          >
            <span>Explorar mapa interactivo</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Hoja elevada del mapa productivo asomando sobre el cierre del hero */}
  <main class="relative z-20 mx-auto max-w-[1600px] px-5 pb-24 sm:px-8 lg:px-10">
    <section id="mapa" class="-mt-14 scroll-mt-24 sm:-mt-20">
      <ArgentinaMapExplorer
        client:load
        continentalGeo={continentalGeo}
        antartidaIslasGeo={antartidaIslasGeo}
        departamentosGeo={departamentosGeo}
        provinciasData={provinciasData}
        departamentosData={departamentosData}
        productos={productos}
        geoManifest={geoManifest}
        esEjemplo={esEjemplo}
      />
    </section>

    {/* Sección interactiva de cadenas y explorador paso a paso */}
    <section id="procesos" class="mt-24 scroll-mt-24">
      <ProcessDeckPreview
        client:load
        productos={productos}
        procesosVerificados={procesosVerificados}
        chainSummaries={chainSummaries}
        esEjemplo={esEjemplo}
      />
    </section>

    {/* Etapa 8: Resumen editorial de empresas predominantes e indicador de cobertura territorial */}
    <section id="empresas-cobertura" class="mt-24 scroll-mt-24">
      <div class="grid gap-6 lg:grid-cols-12">
        {/* Directorio compacto de empresas verificables */}
        <div class="flex flex-col justify-between border border-rule bg-stone-surface p-6 sm:p-7 lg:col-span-7">
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-rule pb-4">
              <div>
                <h2 class="font-display text-[22px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
                  Empresas predominantes y plantas
                </h2>
                <p class="mt-1 text-[14px] font-normal text-ink-muted">
                  Solo hechos verificables con fuente pública, sin facturación ni cuotas estimadas.
                </p>
              </div>
              <a
                href="/empresas"
                class="text-[13px] font-medium text-cobalt hover:underline"
              >
                Ver directorio →
              </a>
            </div>

            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
              {empresasConPlantas.map((item) => (
                <li>
                  <a
                    href={`/empresas#${item.empresa.empresa_id}`}
                    class="group flex h-full flex-col justify-between border border-rule bg-stone-bg p-4 transition-colors duration-150 hover:border-ink hover:bg-stone-surface"
                  >
                    <div>
                      <h3 class="font-display text-[15px] font-medium leading-snug tracking-[-0.01em] text-ink group-hover:text-cobalt">
                        {item.empresa.razon_social}
                      </h3>
                      <p class="mt-1 text-[13px] font-normal text-ink-muted">
                        {item.productos.map((p) => p.nombre).join(' · ')}
                      </p>
                    </div>
                    <p class="mt-3 text-[12px] font-normal text-ink-muted tabular-nums">
                      {item.provincias.map((p) => p.nombre).join(', ')} · {item.plantas.length}{' '}
                      {item.plantas.length === 1 ? 'planta' : 'plantas'} · Capital{' '}
                      {item.empresa.tipo_capital}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <p class="mt-6 border-t border-rule pt-4 text-[13px] font-normal text-ink-muted tabular-nums">
            {cobertura.totales.empresasVerificadas} empresas verificadas ·{' '}
            {cobertura.totales.plantasGeorreferenciadas} plantas georreferenciadas
          </p>
        </div>

        {/* Indicador honesto de cobertura territorial */}
        <div class="flex flex-col justify-between border border-rule bg-stone-surface p-6 sm:p-7 lg:col-span-5">
          <div>
            <div class="border-b border-rule pb-4">
              <h2 class="font-display text-[22px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
                Indicador de cobertura
              </h2>
              <p class="mt-1 text-[14px] font-normal text-ink-muted">
                Donde faltan datos confiables, el atlas lo declara sin estimaciones.
              </p>
            </div>

            <div class="mt-5">
              <div class="flex items-baseline justify-between text-[14px] tabular-nums">
                <span class="font-normal text-ink">Cobertura jurisdiccional verificada</span>
                <span class="font-display text-[19px] font-medium tracking-[-0.02em] text-cobalt">
                  {cobertura.totales.provinciasConDatos} / {cobertura.totales.totalProvincias} ({pctCobertura}%)
                </span>
              </div>
              <div class="mt-2 h-2 w-full bg-stone-subtle">
                <div class="h-full bg-cobalt" style={{ width: `${pctCobertura}%` }} />
              </div>
              <p class="mt-2.5 text-[13px] font-normal text-ink-muted tabular-nums">
                {cobertura.totales.departamentosConDatos} departamentos confiables ·{' '}
                {cobertura.totales.provinciasSinDatos} provincias declaradas sin datos ·{' '}
                {cobertura.totales.fuentesVerificadas} fuentes con SHA-256.
              </p>
            </div>

            {/* Desglose compacto por región */}
            <ul class="mt-5 divide-y divide-rule border-t border-rule text-[13px] tabular-nums">
              {cobertura.porRegion.map((reg) => (
                <li class="flex items-center justify-between gap-3 py-2.5">
                  <span class="font-normal text-ink">{reg.region}</span>
                  <div class="flex items-center gap-3">
                    <div class="h-1.5 w-24 bg-stone-subtle">
                      <div
                        class={`h-full ${reg.conDatos > 0 ? 'bg-cobalt' : 'bg-ink-muted/25'}`}
                        style={{ width: `${reg.porcentaje}%` }}
                      />
                    </div>
                    <span class="w-16 text-right text-ink-muted">
                      {reg.conDatos} de {reg.total}
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 border-t border-rule pt-4">
            <a
              href="/cobertura"
              class="inline-flex w-full items-center justify-center bg-ink px-4 py-2.5 text-[13px] font-medium text-white transition-colors duration-150 hover:bg-cobalt"
            >
              <span>Ver tablero de cobertura y faltantes</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Toda cifra exige año, organismo, URL y verificación de archivo; los
        faltantes se declaran sin datos.
      </p>
      <div class="flex flex-wrap items-center gap-5 tabular-nums">
        <a href="/comparar" class="font-medium text-ink hover:text-cobalt">Comparar</a>
        <a href="/empresas" class="font-medium text-ink hover:text-cobalt">Empresas</a>
        <a href="/cobertura" class="font-medium text-ink hover:text-cobalt">Cobertura</a>
        <span>Límites provinciales: {geoManifest.organismo} ({geoManifest.fecha_descarga})</span>
      </div>
    </div>
  </footer>
</BaseLayout>
