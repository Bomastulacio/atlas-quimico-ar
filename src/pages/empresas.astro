---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { EmpresasExplorer } from '@/components/EmpresasExplorer';
import {
  getCoberturaDetallada,
  getEmpresasConPlantas,
  getProductos,
  getSearchIndex,
} from '@/data';

const empresas = getEmpresasConPlantas();
const productos = getProductos();
const cobertura = getCoberturaDetallada();
const searchItems = getSearchIndex();

const plantasConCapacidad =
  cobertura.totales.plantasGeorreferenciadas - cobertura.totales.plantasSinCapacidadPublica;
---

<BaseLayout
  title="Empresas y plantas verificadas | Atlas Químico Argentino"
  description="Directorio de empresas predominantes y plantas industriales en Argentina con hechos verificables, coordenadas, capacidad nominal declarada y fuentes primarias auditadas."
>
  <SiteHeader client:load variant="solid" searchItems={searchItems} currentPath="/empresas" />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-8 sm:px-8 lg:px-10">
    {/* Navegación contextual */}
    <nav
      aria-label="Ruta de navegación"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a href="/#mapa" class="font-medium text-ink transition-colors duration-150 hover:text-cobalt">
        ← Volver al mapa territorial
      </a>
      <div class="flex items-center gap-4">
        <a href="/cobertura" class="transition-colors duration-150 hover:text-ink">
          Ver cobertura de datos ({cobertura.totales.provinciasConDatos}/24)
        </a>
      </div>
    </nav>

    {/* Cabecera editorial y regla metodológica explícita */}
    <section class="border-b border-rule pb-8">
      <div class="max-w-3xl">
        <h1 class="font-display text-[clamp(2rem,3.4vw,3rem)] font-bold leading-[1.06] tracking-[-0.03em] text-ink">
          Empresas predominantes y plantas verificadas
        </h1>
        <p class="mt-3 text-[15px] leading-relaxed text-ink-muted sm:text-[16px]">
          Registro exclusivo de hechos verificables (razón social, planta, localidad, coordenadas,
          producto, capacidad nominal declarada y año) respaldados por memorias ante CNV, fichas
          operativas oficiales y organismos públicos. Nunca se publican estimaciones de facturación
          ni cuotas de mercado inventadas.
        </p>
      </div>

      {/* 4 métricas verificadas reales desde Supabase */}
      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        <div>
          <dt class="text-[13px] text-ink-muted">Empresas relevadas</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ink">
            {cobertura.totales.empresasVerificadas}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            En {cobertura.totales.cadenasVerificadas} cadenas industriales verificadas
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Plantas georreferenciadas</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-cobalt">
            {cobertura.totales.plantasGeorreferenciadas}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Con coordenadas WGS84 y vínculo Georef
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Capacidad nominal publicada</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-emerald-react">
            {plantasConCapacidad} de {cobertura.totales.plantasGeorreferenciadas}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Cifras extraídas directo de fuente primaria
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Capacidad declarada sin datos</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ink-muted">
            {cobertura.totales.plantasSinCapacidadPublica}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Sin cifra pública auditada (no se estima)
          </p>
        </div>
      </dl>
    </section>

    {/* Explorador interactivo */}
    <section class="pt-10">
      <EmpresasExplorer client:load empresas={empresas} productos={productos} />
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Apartado de empresas con trazabilidad verificable; toda cifra sin
        fuente pública figura como sin datos.
      </p>
      <div class="flex items-center gap-5">
        <a href="/cobertura" class="hover:text-cobalt">Cobertura territorial</a>
        <a href="/" class="font-medium text-ink hover:text-cobalt">← Volver al mapa</a>
      </div>
    </div>
  </footer>
</BaseLayout>
