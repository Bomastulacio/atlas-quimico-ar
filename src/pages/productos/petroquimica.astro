---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SiteHeader } from "@/components/SiteHeader";
import { StandaloneCompanyMarket } from "@/components/CompanyMarketCard";
import { ProcessFlowDiagram } from "@/components/ProcessFlowDiagram";
import { ProductIcon } from "@/components/ProductIcon";
import PetroquimicaEssay from "@/content/productos/petroquimica.mdx";
import {
  getFichaProducto,
  getFuentes,
  getMercadoSnapshot,
  getSearchIndex,
} from "@/data";

const searchItems = getSearchIndex();
const mercadoSnapshot = getMercadoSnapshot();

const ficha = getFichaProducto("petroquimica");
if (!ficha) {
  throw new Error(
    'No se encontró la ficha del producto "petroquimica" en la capa de datos.',
  );
}

const procesoPrincipal = ficha.procesos[0];
if (!procesoPrincipal) {
  throw new Error(
    "No se encontró el proceso principal de petroquímica en la capa de datos.",
  );
}

const comexUsd = ficha.comercioExterior
  .filter((r) => r.metrica === "valor_usd")
  .sort(
    (a, b) =>
      b.anio - a.anio || (a.ncm_codigo ?? "").localeCompare(b.ncm_codigo ?? ""),
  );

const peLdpe24 = ficha.comercioExterior.find(
  (c) => c.registro_id === "comex-pe-390110-2024-usd",
);
const peHdpe24 = ficha.comercioExterior.find(
  (c) => c.registro_id === "comex-pe-390120-2024-usd",
);
const prodRow = ficha.produccion[0];

const citedFuenteIds = new Set<string>([
  ...ficha.zonas.map((z) => z.procedencia.fuente_id),
  ...ficha.procesos.map((p) => p.proceso.procedencia.fuente_id),
  ...ficha.procesos.flatMap((p) => p.pasos.map((s) => s.procedencia.fuente_id)),
  ...ficha.procesos.flatMap((p) =>
    p.conexiones.map((c) => c.procedencia.fuente_id),
  ),
  ...ficha.procesos.flatMap((p) => Object.keys(p.pfdFuentes)),
  ...ficha.plantas.map((pl) => pl.procedencia.fuente_id),
  ...ficha.plantas
    .map((pl) => pl.empresa?.procedencia.fuente_id)
    .filter((id): id is string => Boolean(id)),
  ...ficha.produccion.map((pr) => pr.procedencia.fuente_id),
  ...ficha.comercioExterior.map((ce) => ce.procedencia.fuente_id),
]);

const fuentesCitadas = getFuentes().filter((f) =>
  citedFuenteIds.has(f.fuente_id),
);

const NCM_LABEL: Record<string, string> = {
  "3901.10": "Polietileno baja densidad / lineal (LDPE/LLDPE)",
  "3901.20": "Polietileno alta densidad (HDPE)",
  "3904.10": "Policloruro de vinilo sin mezclar (PVC)",
};

const TIPO_FUENTE_LABEL: Record<string, string> = {
  oficial: "Oficial",
  tecnica: "Técnica internacional",
  empresa: "Empresa (oficial)",
  ejemplo: "Ejemplo",
};
---

<BaseLayout
  title="Petroquímica: etileno y polietileno (Bahía Blanca) | Atlas Químico Argentino"
  description="Ficha verificada del Polo Petroquímico de Bahía Blanca: steam cracking de etano (IPCC Cap. 3.9), complejos Dow y Unipar Indupa, y comercio exterior UN Comtrade."
>
  <SiteHeader
    client:load
    variant="solid"
    searchItems={searchItems}
    currentPath="/productos/petroquimica"
  />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-6 sm:px-8 lg:px-10">
    <nav
      aria-label="Secciones de la ficha"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a
        href="/#mapa"
        class="font-medium text-ink transition-colors duration-150 hover:text-cobalt"
      >
        ← Volver al mapa territorial
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#diagrama"
          class="transition-colors duration-150 hover:text-ink"
        >
          Diagrama
        </a>
        <a href="#datos" class="transition-colors duration-150 hover:text-ink">
          Comercio y auditoría
        </a>
        <a
          href="#empresas"
          class="transition-colors duration-150 hover:text-ink tabular-nums"
        >
          Complejos ({ficha.plantas.length})
        </a>
        <a
          href="#fuentes"
          class="transition-colors duration-150 hover:text-ink tabular-nums"
        >
          Fuentes ({fuentesCitadas.length})
        </a>
      </div>
    </nav>
    <section class="border-b border-rule pb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center bg-signal-red text-white">
            <ProductIcon iconId={ficha.producto.icono_id} size={24} />
          </span>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h1 class="font-display text-[clamp(2rem,3.4vw,3rem)] font-bold leading-[1.06] tracking-[-0.03em] text-ink">
                {ficha.producto.nombre}
              </h1>
              {ficha.producto.formula_quimica && (
                <span class="font-display text-[22px] font-semibold text-signal-red tabular-nums">
                  {ficha.producto.formula_quimica}
                </span>
              )}
            </div>
            <p class="mt-2 max-w-[68ch] text-[15px] text-ink-muted">
              {ficha.producto.descripcion_corta}
            </p>
            <p class="mt-2 text-[13px] text-ink-muted tabular-nums">
              Jurisdicción: Buenos Aires (Georef 06) · Departamento Bahía Blanca
              (Georef 06056) · Polo Petroquímico
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-[13px] font-medium text-ink">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-react" />
          <span>Cadena verificada · 6 verificadores químicos aprobados</span>
        </div>
      </div>

      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        <div>
          <dt class="text-[13px] text-ink-muted">
            Producción anual pública auditada
          </dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ink-muted">
            {prodRow?.medicion.estado === "dato"
              ? `${prodRow.medicion.valor.toLocaleString("es-AR")} t`
              : "Sin datos"}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Dataset 41 descartado por error en origen
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">
            Rendimiento etano a etileno
          </dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-cobalt">
            1,245 t/t
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            803 kg C2H4/t C2H6 · IPCC Table 3.25
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">
            Emisión directa en cracking
          </dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-signal-red">
            0,95 t CO2/t
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Carga etano · IPCC 2006 Table 3.14
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Saldo comercial PE (2024)</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ochre-metal">
            {peLdpe24?.saldo_comercial.estado === "dato" &&
            peHdpe24?.saldo_comercial.estado === "dato"
              ? `USD ${(peLdpe24.saldo_comercial.valor + peHdpe24.saldo_comercial.valor).toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
              : "Sin datos"}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            HS 3901.10 + 3901.20 · UN Comtrade
          </p>
        </div>
      </dl>
    </section>

    <section id="diagrama" class="scroll-mt-20 pt-12">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
            Diagrama interactivo de steam cracking y polimerización
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">
            Modelado según IPCC 2006 Cap. 3.9 (Table 3.14 y Table 3.25) con
            reciclo de etano no convertido desde la destilación criogénica hacia
            los hornos de pirólisis.
          </p>
        </div>
        <p class="text-[13px] text-ink-muted tabular-nums">
          Reacción global:{" "}
          <strong class="font-semibold text-ink">
            {procesoPrincipal.proceso.reaccion_global}
          </strong>{" "}
          (mín. teórico 1,072 t C2H6/t C2H4)
        </p>
      </div>

      <ProcessFlowDiagram client:load procesoCompleto={procesoPrincipal} />
    </section>

    <section id="datos" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Comercio exterior de polímeros y transparencia de producción
        </h2>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="border border-rule bg-stone-surface p-6 lg:col-span-4">
          <h3 class="font-display text-[20px] font-semibold text-ink">
            Auditoría de producción física
          </h3>
          <p class="mt-2 text-[14px] text-ink-muted">
            Estado actual:{" "}
            <strong class="text-ink">Sin datos públicos auditados</strong>.
          </p>
          <p class="mt-3 text-[14px] text-ink-muted">
            Se auditaron las series{" "}
            <code class="bg-stone-subtle px-1 text-ink">41.3_E_0_A_7</code> y{" "}
            <code class="bg-stone-subtle px-1 text-ink">41.3_P_0_A_11</code> del
            portal{" "}
            <code class="bg-stone-subtle px-1 text-ink">datos.gob.ar</code> y se
            descartaron por inconsistencias de escala/corrimiento en origen
            dentro del dataset 41. Nunca estimamos cifras faltantes.
          </p>
        </div>

        <div class="border border-rule bg-stone-surface p-6 lg:col-span-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-[20px] font-semibold text-ink">
              Comercio exterior de resinas (HS 3901.10, 3901.20 y 3904.10)
            </h3>
            <span class="text-[13px] text-ink-muted">
              Millones de USD · UN Comtrade
            </span>
          </div>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-left text-[14px] tabular-nums">
              <thead>
                <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                  <th class="py-2.5 pr-4 font-medium">Resina (HS)</th>
                  <th class="px-3 py-2.5 font-medium">Año</th>
                  <th class="px-3 py-2.5 text-right font-medium">Exp.</th>
                  <th class="px-3 py-2.5 text-right font-medium">Imp.</th>
                  <th class="py-2.5 pl-3 text-right font-medium">Saldo</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-rule">
                {comexUsd.map((row) => (
                  <tr>
                    <td class="py-2.5 pr-4 font-medium text-ink">
                      {NCM_LABEL[row.ncm_codigo ?? ""] ?? row.ncm_codigo}
                    </td>
                    <td class="px-3 py-2.5 text-ink-muted">{row.anio}</td>
                    <td class="px-3 py-2.5 text-right text-ink">
                      {row.exportacion.estado === "dato"
                        ? `USD ${row.exportacion.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
                        : "Sin datos"}
                    </td>
                    <td class="px-3 py-2.5 text-right text-ochre-metal">
                      {row.importacion.estado === "dato"
                        ? `USD ${row.importacion.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
                        : "Sin datos"}
                    </td>
                    <td class="py-2.5 pl-3 text-right font-semibold text-signal-red">
                      {row.saldo_comercial.estado === "dato"
                        ? `USD ${row.saldo_comercial.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
                        : "Sin datos"}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="empresas" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Complejos petroquímicos registrados en Bahía Blanca
        </h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {ficha.plantas.map((pl) => (
          <article class="flex flex-col justify-between border border-rule bg-stone-surface p-6">
            <div>
              <h3 class="font-display text-[20px] font-semibold text-ink">
                {pl.nombre}
              </h3>
              <p class="mt-1 text-[13px] text-ink-muted tabular-nums">
                {pl.localidad}, Buenos Aires ({pl.lat.toFixed(3)},{" "}
                {pl.lon.toFixed(3)})
              </p>
              {pl.empresa && (
                <p class="mt-3 text-[15px] text-ink-muted">
                  {pl.empresa.hechos_verificables}
                </p>
              )}
              <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-rule pt-4 text-[14px] tabular-nums">
                <div>
                  <dt class="text-[12px] text-ink-muted">Operador</dt>
                  <dd class="font-medium text-ink">
                    {pl.empresa?.razon_social ?? "Sin registrar"}
                  </dd>
                </div>
                <div>
                  <dt class="text-[12px] text-ink-muted">
                    Capacidad publicada
                  </dt>
                  <dd class="font-medium text-ink-muted">
                    {pl.capacidad.estado === "dato"
                      ? `${pl.capacidad.valor.toLocaleString("es-AR")} ${pl.capacidad.unidad}`
                      : "Sin datos"}
                  </dd>
                </div>
              </dl>
              {pl.empresa && (
                <StandaloneCompanyMarket
                  client:load
                  empresaId={pl.empresa.empresa_id}
                  initialSnapshot={mercadoSnapshot}
                />
              )}
            </div>
            <p class="mt-4 border-t border-rule pt-3 text-[12px] text-ink-muted">
              Cita ({pl.procedencia.anio}): {pl.procedencia.cita_ubicacion}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="pt-16">
      <div class="border border-rule bg-stone-surface p-6 sm:p-8 lg:p-10">
        <div class="atlas-prose max-w-[74ch]">
          <PetroquimicaEssay />
        </div>
      </div>
    </section>

    <section id="fuentes" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Registro de fuentes oficiales y verificación SHA-256
        </h2>
      </div>
      <div class="mt-6 overflow-x-auto border border-rule bg-stone-surface">
        <table class="w-full border-collapse text-left text-[13px]">
          <thead>
            <tr class="border-b border-rule bg-stone-subtle text-ink-muted">
              <th class="px-4 py-3 font-medium">Fuente</th>
              <th class="px-4 py-3 font-medium">Organismo</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Descarga</th>
              <th class="px-4 py-3 font-medium">Hash SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            {fuentesCitadas.map((f) => (
              <tr class="align-top">
                <td class="px-4 py-3">
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-cobalt hover:underline"
                  >
                    {f.nombre} ↗
                  </a>
                  {f.notas && <p class="mt-1 text-ink-muted">{f.notas}</p>}
                </td>
                <td class="px-4 py-3 text-ink">{f.organismo}</td>
                <td class="px-4 py-3 text-ink-muted">
                  {TIPO_FUENTE_LABEL[f.tipo] ?? f.tipo}
                </td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">
                  {f.fecha_descarga}
                </td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">
                  <span title={f.hash}>{f.hash.slice(0, 22)}...</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Ficha petroquímica (Bahía Blanca) validada bajo
        política strictReal.
      </p>
      <a href="/" class="font-medium text-ink hover:text-cobalt">
        ← Volver al mapa productivo
      </a>
    </div>
  </footer>
</BaseLayout>
