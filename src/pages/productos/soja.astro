---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { StandaloneCompanyMarket } from '@/components/CompanyMarketCard';
import { ProcessFlowDiagram } from '@/components/ProcessFlowDiagram';
import { ProductIcon } from '@/components/ProductIcon';
import SojaEssay from '@/content/productos/soja.mdx';
import { getFichaProducto, getFuentes, getMercadoSnapshot, getSearchIndex } from '@/data';

const searchItems = getSearchIndex();
const mercadoSnapshot = getMercadoSnapshot();

const ficha = getFichaProducto("soja");
if (!ficha) {
  throw new Error(
    'No se encontró la ficha del producto "soja" en la capa de datos.',
  );
}

const procesoPrincipal = ficha.procesos[0];
if (!procesoPrincipal) {
  throw new Error(
    "No se encontró el proceso principal de soja en la capa de datos.",
  );
}

const prodSf = ficha.produccion
  .filter((r) => r.provincia_id === "82")
  .sort((a, b) => b.anio - a.anio);
const prodNacional = ficha.produccion
  .filter((r) => r.provincia_id === null)
  .sort((a, b) => b.anio - a.anio);

const maxProdSf = Math.max(
  ...prodSf.map((r) => (r.medicion.estado === "dato" ? r.medicion.valor : 0)),
  1,
);

const comexUsd = ficha.comercioExterior
  .filter((r) => r.metrica === "valor_usd")
  .sort(
    (a, b) =>
      b.anio - a.anio || (a.ncm_codigo ?? "").localeCompare(b.ncm_codigo ?? ""),
  );
const comexVol = ficha.comercioExterior
  .filter((r) => r.metrica === "volumen_t")
  .sort(
    (a, b) =>
      b.anio - a.anio || (a.ncm_codigo ?? "").localeCompare(b.ncm_codigo ?? ""),
  );

const ultimoSf = prodSf[0];
const ultimoNac = prodNacional[0];
const harina24 = ficha.comercioExterior.find(
  (c) => c.registro_id === "comex-soja-harina-230400-2024-usd",
);
const aceite24 = ficha.comercioExterior.find(
  (c) => c.registro_id === "comex-soja-aceite-150710-2024-usd",
);

const citedFuenteIds = new Set<string>([
  ...ficha.zonas.map((z) => z.procedencia.fuente_id),
  ...ficha.procesos.map((p) => p.proceso.procedencia.fuente_id),
  ...ficha.procesos.flatMap((p) => p.pasos.map((s) => s.procedencia.fuente_id)),
  ...ficha.procesos.flatMap((p) =>
    p.conexiones.map((c) => c.procedencia.fuente_id),
  ),
  ...ficha.plantas.map((pl) => pl.procedencia.fuente_id),
  ...ficha.plantas
    .map((pl) => pl.empresa?.procedencia.fuente_id)
    .filter((id): id is string => Boolean(id)),
  ...ficha.produccion.map((pr) => pr.procedencia.fuente_id),
  ...ficha.comercioExterior.map((ce) => ce.procedencia.fuente_id),
]);

const fuentesCitadas = getFuentes().filter((f) =>
  citedFuenteIds.has(f.fuente_id),
);

const NCM_LABEL: Record<string, string> = {
  "2304.00": "Harina y pellets de soja",
  "1507.10": "Aceite crudo de soja",
  "1201.90": "Poroto de soja (insumo)",
};

const TIPO_FUENTE_LABEL: Record<string, string> = {
  oficial: "Oficial",
  tecnica: "Técnica internacional",
  empresa: "Empresa (oficial)",
  ejemplo: "Ejemplo",
};
---

<BaseLayout
  title="Soja: molienda, aceite y harina (Santa Fe) | Atlas Químico Argentino"
  description="Ficha verificada del complejo oleaginoso de soja en Argentina: extracción por solvente hexano en San Lorenzo y Timbúes, series SAGyP 2026 y UN Comtrade."
>
  <SiteHeader
    client:load
    variant="solid"
    searchItems={searchItems}
    currentPath="/productos/soja"
  />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-6 sm:px-8 lg:px-10">
    <nav
      aria-label="Secciones de la ficha"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a
        href="/#mapa"
        class="font-medium text-ink transition-colors duration-150 hover:text-cobalt"
      >
        ← Volver al mapa territorial
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#diagrama"
          class="transition-colors duration-150 hover:text-ink"
        >
          Diagrama
        </a>
        <a href="#datos" class="transition-colors duration-150 hover:text-ink">
          Producción y comercio
        </a>
        <a
          href="#empresas"
          class="transition-colors duration-150 hover:text-ink tabular-nums"
        >
          Complejos ({ficha.plantas.length})
        </a>
        <a
          href="#fuentes"
          class="transition-colors duration-150 hover:text-ink tabular-nums"
        >
          Fuentes ({fuentesCitadas.length})
        </a>
      </div>
    </nav>
    <section class="border-b border-rule pb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center bg-ochre-metal text-white">
            <ProductIcon iconId={ficha.producto.icono_id} size={24} />
          </span>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h1 class="font-display text-[clamp(1.85rem,3vw,2.6rem)] font-medium leading-[1.06] tracking-[-0.032em] text-ink">
                {ficha.producto.nombre}
              </h1>
              {ficha.producto.formula_quimica && (
                <span class="font-display text-[19px] font-medium text-ochre-metal tabular-nums">
                  {ficha.producto.formula_quimica}
                </span>
              )}
            </div>
            <p class="mt-2 max-w-[68ch] text-[15px] text-ink-muted">
              {ficha.producto.descripcion_corta}
            </p>
            <p class="mt-2 text-[13px] text-ink-muted tabular-nums">
              Jurisdicción: Santa Fe (Georef 82) · Departamentos San Lorenzo
              (82119) y Rosario (82084) · Polo Up-River
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-[13px] font-medium text-ink">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-react" />
          <span>Cadena verificada · 6 verificadores químicos aprobados</span>
        </div>
      </div>

      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        <div>
          <dt class="text-[13px] text-ink-muted">
            Cosecha Santa Fe (camp. 2024/25)
          </dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-ink">
            {ultimoSf?.medicion.estado === "dato"
              ? `${(ultimoSf.medicion.valor / 1e6).toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mt`
              : "Sin datos"}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            País:{" "}
            {ultimoNac?.medicion.estado === "dato"
              ? `${(ultimoNac.medicion.valor / 1e6).toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mt`
              : "s/d"}{" "}
            · SAGyP
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">
            Exportación harina HS 2304.00 (2024)
          </dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-emerald-react">
            {harina24?.exportacion.estado === "dato"
              ? `USD ${harina24.exportacion.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
              : "Sin datos"}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            16,67 Mt despachadas · UN Comtrade
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">
            Exportación aceite HS 1507.10 (2024)
          </dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-cobalt">
            {aceite24?.exportacion.estado === "dato"
              ? `USD ${aceite24.exportacion.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
              : "Sin datos"}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            4,98 Mt despachadas · UN Comtrade
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">
            Planta ancla Timbúes (Renova)
          </dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-ochre-metal">
            32.400 t/día
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Molienda de soja + 6 Mt/año Molinos Agro
          </p>
        </div>
      </dl>
    </section>

    <section id="diagrama" class="scroll-mt-24 pt-16">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
            Diagrama interactivo de molienda y extracción con hexano
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">
            Generado desde Supabase. Incluye la bifuración en harina proteica
            (~0,76 t/t) y aceite crudo (~0,19 t/t) con reciclo en circuito
            cerrado del solvente hexano (C6H14).
          </p>
        </div>
        <p class="text-[13px] text-ink-muted tabular-nums">
          Relación exportada 2024:{" "}
          <strong class="font-medium text-ink">
            3,35 t harina / t aceite
          </strong>
        </p>
      </div>

      <ProcessFlowDiagram client:load procesoCompleto={procesoPrincipal} />
    </section>

    <section id="datos" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Cosecha provincial y comercio exterior del complejo sojero
        </h2>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="border border-rule bg-stone-surface p-6 lg:col-span-5">
          <h3 class="font-display text-[17px] font-medium leading-[1.24] tracking-[-0.015em] text-ink">
            Producción de poroto en Santa Fe
          </h3>
          <p class="mt-1 text-[13px] text-ink-muted">
            Fuente: SAGyP Estimaciones Agrícolas (marzo 2026), provincia Georef
            82.
          </p>

          <div class="mt-5 space-y-3.5 tabular-nums">
            {prodSf.map((reg) => {
              const val =
                reg.medicion.estado === "dato" ? reg.medicion.valor : 0;
              const widthPct = (val / maxProdSf) * 100;
              return (
                <div>
                  <div class="flex items-baseline justify-between text-[14px]">
                    <span class="font-medium text-ink">
                      Camp. {reg.anio - 1}/{String(reg.anio).slice(-2)}
                    </span>
                    <span class="font-medium text-ink">
                      {reg.medicion.estado === "dato"
                        ? `${reg.medicion.valor.toLocaleString("es-AR")} t`
                        : "Sin datos"}
                    </span>
                  </div>
                  <div class="mt-1.5 h-2 w-full bg-stone-subtle">
                    <div
                      class="h-full bg-ochre-metal"
                      style={{ width: `${widthPct.toFixed(1)}%` }}
                    />
                  </div>
                </div>
              );
            })}
          </div>

          <div class="mt-6 border-t border-rule pt-5 text-[13px] tabular-nums">
            <p class="font-medium text-ink">Total nacional de soja (SAGyP)</p>
            <ul class="mt-2 divide-y divide-rule">
              {prodNacional.map((reg) => (
                <li class="flex justify-between py-1.5">
                  <span class="text-ink-muted">
                    Camp. {reg.anio - 1}/{String(reg.anio).slice(-2)}
                  </span>
                  <span class="font-medium text-ink">
                    {reg.medicion.estado === "dato"
                      ? `${reg.medicion.valor.toLocaleString("es-AR")} t`
                      : "Sin datos"}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="space-y-6 lg:col-span-7">
          <div class="border border-rule bg-stone-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-[17px] font-medium leading-[1.24] tracking-[-0.015em] text-ink">
                Comercio exterior industrial en valor (USD)
              </h3>
              <span class="text-[13px] text-ink-muted">
                Millones de USD · UN Comtrade
              </span>
            </div>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                <thead>
                  <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                    <th class="py-2.5 pr-4 font-medium">Producto (HS)</th>
                    <th class="px-3 py-2.5 font-medium">Año</th>
                    <th class="px-3 py-2.5 text-right font-medium">
                      Exportaciones
                    </th>
                    <th class="py-2.5 pl-3 text-right font-medium">Saldo</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rule">
                  {comexUsd.map((row) => (
                    <tr>
                      <td class="py-2.5 pr-4 font-medium text-ink">
                        {NCM_LABEL[row.ncm_codigo ?? ""] ?? row.ncm_codigo}{" "}
                        <span class="text-[12px] text-ink-muted">
                          ({row.ncm_codigo})
                        </span>
                      </td>
                      <td class="px-3 py-2.5 text-ink-muted">{row.anio}</td>
                      <td class="px-3 py-2.5 text-right text-ink">
                        {row.exportacion.estado === "dato"
                          ? `USD ${row.exportacion.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
                          : "Sin datos"}
                      </td>
                      <td class="py-2.5 pl-3 text-right font-medium text-emerald-react">
                        {row.saldo_comercial.estado === "dato"
                          ? `+USD ${row.saldo_comercial.valor.toLocaleString("es-AR", { minimumFractionDigits: 2 })} M`
                          : "Sin datos"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div class="border border-rule bg-stone-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-[17px] font-medium leading-[1.24] tracking-[-0.015em] text-ink">
                Volúmenes físicos despachados e importados (2024)
              </h3>
              <span class="text-[13px] text-ink-muted">
                Toneladas · UN Comtrade
              </span>
            </div>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                <thead>
                  <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                    <th class="py-2.5 pr-4 font-medium">Posición</th>
                    <th class="px-3 py-2.5 text-right font-medium">
                      Exportación
                    </th>
                    <th class="py-2.5 pl-3 text-right font-medium">
                      Importación
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rule">
                  {comexVol.map((row) => (
                    <tr>
                      <td class="py-2.5 pr-4 font-medium text-ink">
                        {NCM_LABEL[row.ncm_codigo ?? ""] ?? row.ncm_codigo} (
                        {row.ncm_codigo})
                      </td>
                      <td class="px-3 py-2.5 text-right text-emerald-react font-medium">
                        {row.exportacion.estado === "dato"
                          ? `${Math.round(row.exportacion.valor).toLocaleString("es-AR")} t`
                          : "Sin datos"}
                      </td>
                      <td class="py-2.5 pl-3 text-right text-ink-muted">
                        {row.importacion.estado === "dato"
                          ? `${Math.round(row.importacion.valor).toLocaleString("es-AR")} t`
                          : "Sin datos"}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="empresas" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Complejos industriales ancla en San Lorenzo y Timbúes
        </h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {ficha.plantas.map((pl) => (
          <article class="flex flex-col justify-between border border-rule bg-stone-surface p-6">
            <div>
              <h3 class="font-display text-[17px] font-medium leading-[1.24] tracking-[-0.015em] text-ink">
                {pl.nombre}
              </h3>
              <p class="mt-1 text-[13px] text-ink-muted tabular-nums">
                {pl.localidad}, {pl.provincia?.nombre ?? pl.provincia_id} (
                {pl.lat.toFixed(3)}, {pl.lon.toFixed(3)})
              </p>
              {pl.empresa && (
                <p class="mt-3 text-[15px] text-ink-muted">
                  {pl.empresa.hechos_verificables}
                </p>
              )}
              <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-rule pt-4 text-[14px] tabular-nums">
                <div>
                  <dt class="text-[12px] text-ink-muted">Operador</dt>
                  <dd class="font-medium text-ink">
                    {pl.empresa?.razon_social ?? "Sin registrar"}
                  </dd>
                </div>
                <div>
                  <dt class="text-[12px] text-ink-muted">
                    Capacidad declarada
                  </dt>
                  <dd class="font-medium text-cobalt">
                    {pl.capacidad.estado === "dato"
                      ? `${pl.capacidad.valor.toLocaleString("es-AR")} ${pl.capacidad.unidad}`
                      : "Sin datos"}
                  </dd>
                </div>
              </dl>
              {pl.empresa && (
                <StandaloneCompanyMarket
                  client:load
                  empresaId={pl.empresa.empresa_id}
                  initialSnapshot={mercadoSnapshot}
                />
              )}
            </div>
            <p class="mt-4 border-t border-rule pt-3 text-[12px] text-ink-muted">
              Cita ({pl.procedencia.anio}): {pl.procedencia.cita_ubicacion}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="pt-20">
      <div class="border border-rule bg-stone-surface p-6 sm:p-8 lg:p-10">
        <div class="atlas-prose max-w-[74ch]">
          <SojaEssay />
        </div>
      </div>
    </section>

    <section id="fuentes" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Registro de fuentes oficiales y verificación SHA-256
        </h2>
      </div>
      <div class="mt-6 overflow-x-auto border border-rule bg-stone-surface">
        <table class="w-full border-collapse text-left text-[13px]">
          <thead>
            <tr class="border-b border-rule bg-stone-subtle text-ink-muted">
              <th class="px-4 py-3 font-medium">Fuente</th>
              <th class="px-4 py-3 font-medium">Organismo</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Descarga</th>
              <th class="px-4 py-3 font-medium">Hash SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            {fuentesCitadas.map((f) => (
              <tr class="align-top">
                <td class="px-4 py-3">
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-cobalt hover:underline"
                  >
                    {f.nombre} ↗
                  </a>
                  {f.notas && <p class="mt-1 text-ink-muted">{f.notas}</p>}
                </td>
                <td class="px-4 py-3 text-ink">{f.organismo}</td>
                <td class="px-4 py-3 text-ink-muted">
                  {TIPO_FUENTE_LABEL[f.tipo] ?? f.tipo}
                </td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">
                  {f.fecha_descarga}
                </td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">
                  <span title={f.hash}>{f.hash.slice(0, 22)}...</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Ficha del complejo sojero (Santa Fe) validada
        bajo política strictReal.
      </p>
      <a href="/" class="font-medium text-ink hover:text-cobalt">
        ← Volver al mapa productivo
      </a>
    </div>
  </footer>
</BaseLayout>
