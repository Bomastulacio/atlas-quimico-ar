---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { PolipropilenoProcessAnatomy } from '@/components/PolipropilenoProcessAnatomy';
import { ProcessFlowDiagram } from '@/components/ProcessFlowDiagram';
import { ProductIcon } from '@/components/ProductIcon';
import { getFichaProducto, getFuentes, getSearchIndex } from '@/data';

const searchItems = getSearchIndex();
const ficha = getFichaProducto('polipropileno');
if (!ficha) throw new Error('No se encontró la ficha del producto "polipropileno".');
const procesoPrincipal = ficha.procesos[0];
if (!procesoPrincipal) throw new Error('No se encontró el proceso principal de polipropileno.');

const comexUsd = ficha.comercioExterior
  .filter((r) => r.metrica === 'valor_usd')
  .sort((a, b) => b.anio - a.anio);
const comexVol = ficha.comercioExterior
  .filter((r) => r.metrica === 'volumen_t')
  .sort((a, b) => b.anio - a.anio);

const ultimoUsd = comexUsd[0];
const ultimoVol = comexVol[0];

const citedFuenteIds = new Set<string>([
  ...ficha.zonas.map((z) => z.procedencia.fuente_id),
  ...ficha.procesos.map((p) => p.proceso.procedencia.fuente_id),
  ...ficha.procesos.flatMap((p) => p.pasos.map((s) => s.procedencia.fuente_id)),
  ...ficha.procesos.flatMap((p) => p.conexiones.map((c) => c.procedencia.fuente_id)),
  ...ficha.procesos.flatMap((p) => Object.keys(p.pfdFuentes)),
  ...ficha.plantas.map((pl) => pl.procedencia.fuente_id),
  ...ficha.plantas.map((pl) => pl.empresa?.procedencia.fuente_id).filter((id): id is string => Boolean(id)),
  ...ficha.produccion.map((pr) => pr.procedencia.fuente_id),
  ...ficha.comercioExterior.map((ce) => ce.procedencia.fuente_id),
]);
const fuentesCitadas = getFuentes().filter((f) => citedFuenteIds.has(f.fuente_id));

const TIPO_FUENTE_LABEL: Record<string, string> = {
  oficial: 'Oficial',
  tecnica: 'Técnica internacional',
  empresa: 'Empresa (oficial)',
  ejemplo: 'Ejemplo',
};
---

<BaseLayout
  title="Polipropileno y refinación FCC (Mendoza) | Atlas Químico Argentino"
  description="Ficha verificada del Polo Petroquímico Luján de Cuyo (Mendoza): unidad FCC YPF, splitter C3 y polimerización de polipropileno (Petrocuyo), EU POL BREF y UN Comtrade HS 3902.10."
>
  <SiteHeader client:load variant="solid" searchItems={searchItems} currentPath="/productos/polipropileno" />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-6 sm:px-8 lg:px-10">
    <nav
      aria-label="Secciones de la ficha"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a href="/#mapa" class="font-medium text-ink transition-colors duration-150 hover:text-cobalt">
        ← Volver al mapa territorial
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <a href="#anatomia" class="transition-colors duration-150 hover:text-ink">Planta 3D</a>
        <a href="#diagrama" class="transition-colors duration-150 hover:text-ink">Diagrama PFD</a>
        <a href="#datos" class="transition-colors duration-150 hover:text-ink">Comercio y auditoría</a>
        <a href="#empresas" class="transition-colors duration-150 hover:text-ink">Complejos ({ficha.plantas.length})</a>
        <a href="#fuentes" class="transition-colors duration-150 hover:text-ink tabular-nums">
          Fuentes ({fuentesCitadas.length})
        </a>
      </div>
    </nav>

    <section class="border-b border-rule pb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center bg-signal-red text-white">
            <ProductIcon iconId={ficha.producto.icono_id} size={24} />
          </span>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h1 class="font-display text-[clamp(1.85rem,3vw,2.6rem)] font-medium leading-[1.06] tracking-[-0.032em] text-ink">
                {ficha.producto.nombre}
              </h1>
              <span class="font-display text-[19px] font-medium text-signal-red tabular-nums">
                {ficha.producto.formula_quimica}
              </span>
            </div>
            <p class="mt-2 max-w-[68ch] text-[15px] text-ink-muted">
              {ficha.producto.descripcion_corta}
            </p>
            <p class="mt-2 text-[13px] text-ink-muted tabular-nums">
              Jurisdicción: Mendoza (Georef 50) · Departamento Luján de Cuyo (Georef 50063)
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 text-[13px] font-medium text-ink">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-react" />
          <span>Cadena verificada · Trazabilidad SHA-256</span>
        </div>
      </div>

      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        <div>
          <dt class="text-[13px] text-ink-muted">Producción física anual</dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-ink-muted">
            Sin datos
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">Sin serie abierta auditada (transparencia total)</p>
        </div>
        <div>
          <dt class="text-[13px] text-ink-muted">Exportación HS 3902.10 ({ultimoVol?.anio})</dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-cobalt">
            {ultimoVol?.exportacion.estado === 'dato'
              ? `${Math.round(ultimoVol.exportacion.valor).toLocaleString('es-AR')} t`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">Polipropileno en formas primarias · UN Comtrade</p>
        </div>
        <div>
          <dt class="text-[13px] text-ink-muted">Saldo comercial HS 3902.10 ({ultimoUsd?.anio})</dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-signal-red">
            {ultimoUsd?.saldo_comercial.estado === 'dato'
              ? `USD ${ultimoUsd.saldo_comercial.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} M`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">Exp. 46,15 / Imp. 88,54 M USD · UN Comtrade</p>
        </div>
        <div>
          <dt class="text-[13px] text-ink-muted">Complejos integrados</dt>
          <dd class="mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] text-ink">
            {ficha.plantas.length} plantas
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">Refinería YPF (FCC) + Petrocuyo (PP)</p>
        </div>
      </dl>
    </section>

    <section id="anatomia" class="scroll-mt-24 pt-16">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
            Circuito 3D en movimiento en Mendoza (Luján de Cuyo)
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">
            Lámina interactiva en 3D desde el craqueo catalítico fluido FCC de refinería y el splitter
            C3 hasta la polimerización fase gas Ziegler-Natta, reciclo de monómero y extrusión de
            pellets de polipropileno.
          </p>
        </div>
        <p class="text-[13px] text-ink-muted tabular-nums">
          Orbitá en 3D, cambiá de etapa o grabá un clip WebM a 60 fps
        </p>
      </div>

      <PolipropilenoProcessAnatomy
        client:load
        pasos={procesoPrincipal.pasos}
        exportVol2024T={ultimoVol?.exportacion.estado === 'dato' ? ultimoVol.exportacion.valor : null}
      />
    </section>

    <section id="diagrama" class="scroll-mt-24 pt-20">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
            Diagrama de flujo de proceso (PFD ISO 10628)
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">
            Referencia técnica EU Polymers BREF con superfraccionamiento C3, lazo cerrado de reciclo
            de propileno y Límites de Batería.
          </p>
        </div>
        <p class="text-[13px] text-ink-muted tabular-nums">
          Polimerización: <strong class="font-medium text-ink">{procesoPrincipal.proceso.reaccion_global}</strong>
        </p>
      </div>

      <ProcessFlowDiagram client:load procesoCompleto={procesoPrincipal} />
    </section>

    <section id="datos" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Comercio exterior de polipropileno y auditoría
        </h2>
      </div>
      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="border border-rule bg-stone-surface p-6 lg:col-span-5">
          <h3 class="font-display text-[17px] font-medium text-ink">Auditoría de producción física</h3>
          <p class="mt-2 text-[14px] text-ink-muted">
            Estado actual: <strong class="font-medium text-ink">Sin datos públicos auditados</strong>.
          </p>
          <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">
            Al igual que en el polo petroquímico de Bahía Blanca, no existen series públicas abiertas
            auditadas de toneladas anuales de polipropileno por planta. Se consignan únicamente los
            flujos verificados de comercio exterior aduanero (UN Comtrade HS 3902.10).
          </p>
        </div>
        <div class="border border-rule bg-stone-surface p-6 lg:col-span-7">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-[17px] font-medium text-ink">
              Comercio exterior de polipropileno (HS 3902.10)
            </h3>
            <span class="text-[13px] text-ink-muted">UN Comtrade · Millones USD y toneladas</span>
          </div>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-left text-[14px] tabular-nums">
              <thead>
                <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                  <th class="py-2.5 pr-4 font-medium">Año</th>
                  <th class="px-3 py-2.5 text-right font-medium">Exp. (USD M)</th>
                  <th class="px-3 py-2.5 text-right font-medium">Imp. (USD M)</th>
                  <th class="px-3 py-2.5 text-right font-medium">Saldo (USD M)</th>
                  <th class="py-2.5 pl-3 text-right font-medium">Exp. física</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-rule">
                {comexUsd.map((row) => {
                  const volRow = comexVol.find((v) => v.anio === row.anio);
                  return (
                    <tr>
                      <td class="py-2.5 pr-4 font-medium text-ink">{row.anio}</td>
                      <td class="px-3 py-2.5 text-right text-ink">
                        {row.exportacion.estado === 'dato' ? row.exportacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 }) : 'Sin datos'}
                      </td>
                      <td class="px-3 py-2.5 text-right text-ochre-metal">
                        {row.importacion.estado === 'dato' ? row.importacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 }) : 'Sin datos'}
                      </td>
                      <td class="px-3 py-2.5 text-right font-medium text-signal-red">
                        {row.saldo_comercial.estado === 'dato' ? row.saldo_comercial.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 }) : 'Sin datos'}
                      </td>
                      <td class="py-2.5 pl-3 text-right text-cobalt">
                        {volRow?.exportacion.estado === 'dato' ? `${Math.round(volRow.exportacion.valor).toLocaleString('es-AR')} t` : 'Sin datos'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="empresas" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Complejos georreferenciados en Luján de Cuyo
        </h2>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {ficha.plantas.map((pl) => (
          <article class="border border-rule bg-stone-surface p-6">
            <h3 class="font-display text-[17px] font-medium text-ink">{pl.nombre}</h3>
            <p class="mt-1 text-[13px] text-ink-muted tabular-nums">
              {pl.localidad}, Mendoza · Coord. {pl.lat.toFixed(3)}, {pl.lon.toFixed(3)}
            </p>
            {pl.empresa && (
              <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">{pl.empresa.hechos_verificables}</p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="fuentes" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Fuentes primarias citadas ({fuentesCitadas.length})
        </h2>
      </div>
      <div class="mt-6 overflow-x-auto border border-rule bg-stone-surface">
        <table class="w-full border-collapse text-left text-[13px] tabular-nums">
          <thead>
            <tr class="border-b border-rule bg-stone-bg text-ink-muted">
              <th class="px-4 py-2.5 font-medium">Fuente</th>
              <th class="px-4 py-2.5 font-medium">Organismo</th>
              <th class="px-4 py-2.5 font-medium">Tipo</th>
              <th class="px-4 py-2.5 font-medium">Hash SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            {fuentesCitadas.map((f) => (
              <tr>
                <td class="px-4 py-2.5 font-medium text-ink">
                  <a href={f.url} target="_blank" rel="noopener noreferrer" class="hover:text-cobalt hover:underline">
                    {f.nombre}
                  </a>
                </td>
                <td class="px-4 py-2.5 text-ink-muted">{f.organismo}</td>
                <td class="px-4 py-2.5 text-ink-muted">{TIPO_FUENTE_LABEL[f.tipo] ?? f.tipo}</td>
                <td class="px-4 py-2.5 font-mono text-[12px] text-ink-muted">{f.hash.slice(0, 23)}...</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
