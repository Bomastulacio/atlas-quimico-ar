---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { ProcessFlowDiagram } from '@/components/ProcessFlowDiagram';
import { ProductIcon } from '@/components/ProductIcon';
import UreaEssay from '@/content/productos/urea.mdx';
import { getFichaProducto, getFuentes, getSearchIndex } from '@/data';

const searchItems = getSearchIndex();

const ficha = getFichaProducto('urea');
if (!ficha) {
  throw new Error('No se encontró la ficha del producto "urea" en la capa de datos.');
}

const procesoPrincipal = ficha.procesos[0];
if (!procesoPrincipal) {
  throw new Error('No se encontró el proceso principal de urea en la capa de datos.');
}

const produccionDesc = [...ficha.produccion].sort((a, b) => b.anio - a.anio);
const maxProduccion = Math.max(
  ...produccionDesc.map((r) => (r.medicion.estado === 'dato' ? r.medicion.valor : 0)),
  1
);

const comexUsd = ficha.comercioExterior
  .filter((r) => r.metrica === 'valor_usd')
  .sort((a, b) => b.anio - a.anio);

const comexVol = ficha.comercioExterior
  .filter((r) => r.metrica === 'volumen_t')
  .sort((a, b) => b.anio - a.anio);

const ultimaProduccion = produccionDesc[0];
const produccion2024 = produccionDesc.find((r) => r.anio === 2024);
const ultimoComexUsd = comexUsd[0];
const plantaPrincipal = ficha.plantas[0];
const empresaPrincipal = plantaPrincipal?.empresa ?? null;

const citedFuenteIds = new Set<string>([
  ...ficha.zonas.map((z) => z.procedencia.fuente_id),
  ...ficha.procesos.map((p) => p.proceso.procedencia.fuente_id),
  ...ficha.procesos.flatMap((p) => p.pasos.map((s) => s.procedencia.fuente_id)),
  ...ficha.procesos.flatMap((p) => p.conexiones.map((c) => c.procedencia.fuente_id)),
  ...ficha.plantas.map((pl) => pl.procedencia.fuente_id),
  ...ficha.plantas
    .map((pl) => pl.empresa?.procedencia.fuente_id)
    .filter((id): id is string => Boolean(id)),
  ...ficha.produccion.map((pr) => pr.procedencia.fuente_id),
  ...ficha.comercioExterior.map((ce) => ce.procedencia.fuente_id),
]);

const fuentesCitadas = getFuentes().filter((f) => citedFuenteIds.has(f.fuente_id));

const serieAmoniacoProfertil = [
  { anio: 2025, total: 585710, nota: 'Parada 54 días + inundación marzo 2025' },
  { anio: 2024, total: 810633, nota: '770.033 t a urea + 40.600 t comercializadas' },
  { anio: 2023, total: 734375, nota: 'Producción integrada de amoníaco' },
  { anio: 2022, total: 840759, nota: 'Máximo de la serie 2022-2025' },
];

const TIPO_FUENTE_LABEL: Record<string, string> = {
  oficial: 'Oficial',
  tecnica: 'Técnica internacional',
  empresa: 'Empresa (CNV / oficial)',
  ejemplo: 'Ejemplo',
};
---

<BaseLayout
  title="Urea granulada y amoníaco (Bahía Blanca) | Atlas Químico Argentino"
  description="Ficha verificada de urea en Argentina: síntesis integrada de amoníaco (Haber-Bosch) y urea granulada en Bahía Blanca, serie auditada Profertil CNV 2022-2025 y UN Comtrade."
>
  <SiteHeader client:load variant="solid" searchItems={searchItems} currentPath="/productos/urea" />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-6 sm:px-8 lg:px-10">
    <nav
      aria-label="Secciones de la ficha"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a href="/#mapa" class="font-medium text-ink transition-colors duration-150 hover:text-cobalt">
        ← Volver al mapa territorial
      </a>
      <div class="flex flex-wrap items-center gap-4">
        <a href="#diagrama" class="transition-colors duration-150 hover:text-ink">Diagrama</a>
        <a href="#datos" class="transition-colors duration-150 hover:text-ink">Producción y comercio</a>
        <a href="#empresas" class="transition-colors duration-150 hover:text-ink">Planta</a>
        <a href="#fuentes" class="transition-colors duration-150 hover:text-ink tabular-nums">
          Fuentes ({fuentesCitadas.length})
        </a>
      </div>
    </nav>
    {/* Cabecera de ficha de producto */}
    <section class="border-b border-rule pb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center bg-cobalt text-white">
            <ProductIcon iconId={ficha.producto.icono_id} size={24} />
          </span>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h1 class="font-display text-[clamp(2rem,3.4vw,3rem)] font-bold leading-[1.06] tracking-[-0.03em] text-ink">
                {ficha.producto.nombre}
              </h1>
              {ficha.producto.formula_quimica && (
                <span class="font-display text-[22px] font-semibold text-cobalt tabular-nums">
                  {ficha.producto.formula_quimica}
                </span>
              )}
            </div>
            <p class="mt-2 max-w-[68ch] text-[15px] text-ink-muted">
              {ficha.producto.descripcion_corta}
            </p>
            <p class="mt-2 text-[13px] text-ink-muted tabular-nums">
              Jurisdicción: Buenos Aires (Georef 06) · Departamento Bahía Blanca (Georef 06056) ·
              Ingeniero White
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-[13px] font-medium text-ink">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-react" />
          <span>Cadena verificada · 6 verificadores químicos aprobados</span>
        </div>
      </div>

      {/* 4 magnitudes verificadas */}
      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        <div>
          <dt class="text-[13px] text-ink-muted">Producción auditada ({ultimaProduccion?.anio})</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ink">
            {ultimaProduccion?.medicion.estado === 'dato'
              ? `${ultimaProduccion.medicion.valor.toLocaleString('es-AR')} t`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            {produccion2024?.medicion.estado === 'dato'
              ? `${produccion2024.medicion.valor.toLocaleString('es-AR')} t en 2024 · Profertil / CNV`
              : 'Profertil / CNV'}
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Energía específica de proceso</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-cobalt">
            {procesoPrincipal.proceso.energia_especifica.estado === 'dato'
              ? `${procesoPrincipal.proceso.energia_especifica.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} ${procesoPrincipal.proceso.energia_especifica.unidad}`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Base 30,2 GJ/t NH3 (4,85 MWh/t urea) · IPCC Table 3.1
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Importación de urea HS 3102.10 ({ultimoComexUsd?.anio})</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-ochre-metal">
            {ultimoComexUsd?.importacion.estado === 'dato'
              ? `USD ${ultimoComexUsd.importacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} M`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Déficit neto para abastecer el agro · UN Comtrade ({ultimoComexUsd?.anio})
          </p>
        </div>

        <div>
          <dt class="text-[13px] text-ink-muted">Capacidad instalada nominal</dt>
          <dd class="mt-1 font-display text-[28px] font-bold leading-tight text-emerald-react">
            {plantaPrincipal?.capacidad.estado === 'dato'
              ? `${plantaPrincipal.capacidad.valor.toLocaleString('es-AR')} t`
              : 'Sin datos'}
          </dd>
          <p class="mt-1 text-[13px] text-ink-muted">
            Urea granulada/año (+790.000 t NH3) · Profertil S.A.
          </p>
        </div>
      </dl>
    </section>

    {/* Sección 1: Diagrama de proceso químico interactivo */}
    <section id="diagrama" class="scroll-mt-20 pt-12">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
            Diagrama interactivo de reformado, Haber-Bosch y urea
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">
            Generado desde las tablas validadas en Supabase. Incluye la captura de CO2 del reformado
            hacia síntesis de urea y el reciclo de carbamato no convertido.
          </p>
        </div>
        <p class="text-[13px] text-ink-muted tabular-nums">
          Cruce real Profertil 2024:{' '}
          <strong class="font-semibold text-ink">0,578 t NH3/t urea</strong> (mínimo teórico: 0,567 t/t)
        </p>
      </div>

      <ProcessFlowDiagram client:load procesoCompleto={procesoPrincipal} />
    </section>

    {/* Sección 2: Producción auditada y comercio exterior */}
    <section id="datos" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Producción física y comercio exterior verificados
        </h2>
        <p class="mt-1.5 max-w-[70ch] text-[15px] text-ink-muted">
          Serie física auditada por Profertil S.A. ante la CNV (pág. 88 de EECC al 31/12/2025) y
          registros aduaneros oficiales de UN Comtrade (HS 3102.10).
        </p>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        <div class="border border-rule bg-stone-surface p-6 lg:col-span-5">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-display text-[20px] font-semibold text-ink">
              Producción de urea granulada (46% N)
            </h3>
            <span class="text-[13px] text-ink-muted">Años calendario</span>
          </div>
          <p class="mt-1 text-[13px] text-ink-muted">
            Fuente: Profertil S.A. / CNV (Memoria y EECC al 31/12/2025, pág. 88).
          </p>

          <div class="mt-5 space-y-3.5 tabular-nums">
            {produccionDesc.map((reg) => {
              const val = reg.medicion.estado === 'dato' ? reg.medicion.valor : 0;
              const widthPct = (val / maxProduccion) * 100;
              return (
                <div>
                  <div class="flex items-baseline justify-between text-[14px]">
                    <span class="font-medium text-ink">{reg.anio}</span>
                    <span class="font-semibold text-ink">
                      {reg.medicion.estado === 'dato'
                        ? `${reg.medicion.valor.toLocaleString('es-AR')} t`
                        : 'Sin datos'}
                    </span>
                  </div>
                  <div class="mt-1.5 h-2 w-full bg-stone-subtle">
                    <div
                      class="h-full bg-cobalt"
                      style={{ width: `${widthPct.toFixed(1)}%` }}
                    />
                  </div>
                </div>
              );
            })}
          </div>

          <div class="mt-6 border-t border-rule pt-5">
            <h4 class="text-[13px] font-semibold text-ink">
              Producción integrada de amoníaco anhidro (EECC pág. 88)
            </h4>
            <ul class="mt-2.5 divide-y divide-rule text-[13px] tabular-nums">
              {serieAmoniacoProfertil.map((item) => (
                <li class="flex items-baseline justify-between gap-3 py-1.5">
                  <span class="text-ink-muted">
                    {item.anio} · {item.nota}
                  </span>
                  <span class="shrink-0 font-medium text-ink">
                    {item.total.toLocaleString('es-AR')} t
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="space-y-6 lg:col-span-7">
          <div class="border border-rule bg-stone-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-[20px] font-semibold text-ink">
                Comercio exterior de urea en valor (HS 3102.10)
              </h3>
              <span class="text-[13px] text-ink-muted">Millones de USD · UN Comtrade</span>
            </div>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                <thead>
                  <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                    <th class="py-2.5 pr-4 font-medium">Año</th>
                    <th class="px-4 py-2.5 text-right font-medium">Exportaciones</th>
                    <th class="px-4 py-2.5 text-right font-medium">Importaciones</th>
                    <th class="py-2.5 pl-4 text-right font-medium">Saldo comercial</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rule">
                  {comexUsd.map((row) => (
                    <tr>
                      <td class="py-2.5 pr-4 font-semibold text-ink">{row.anio}</td>
                      <td class="px-4 py-2.5 text-right text-ink">
                        {row.exportacion.estado === 'dato'
                          ? `USD ${row.exportacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} M`
                          : 'Sin datos'}
                      </td>
                      <td class="px-4 py-2.5 text-right font-medium text-ochre-metal">
                        {row.importacion.estado === 'dato'
                          ? `USD ${row.importacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} M`
                          : 'Sin datos'}
                      </td>
                      <td class="py-2.5 pl-4 text-right font-semibold text-signal-red">
                        {row.saldo_comercial.estado === 'dato'
                          ? `USD ${row.saldo_comercial.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })} M`
                          : 'Sin datos'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="mt-3 text-[13px] text-ink-muted">
              Donde el reporte aduanero público no declara un componente (exportaciones de 2024),
              el saldo comercial se mantiene explícitamente como sin datos.
            </p>
          </div>

          <div class="border border-rule bg-stone-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-display text-[20px] font-semibold text-ink">
                Volumen físico declarado (HS 3102.10)
              </h3>
              <span class="text-[13px] text-ink-muted">Toneladas · UN Comtrade</span>
            </div>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                <thead>
                  <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                    <th class="py-2.5 pr-4 font-medium">Año</th>
                    <th class="px-4 py-2.5 text-right font-medium">Exportaciones</th>
                    <th class="px-4 py-2.5 text-right font-medium">Importaciones</th>
                    <th class="py-2.5 pl-4 text-right font-medium">Saldo físico</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rule">
                  {comexVol.map((row) => (
                    <tr>
                      <td class="py-2.5 pr-4 font-semibold text-ink">{row.anio}</td>
                      <td class="px-4 py-2.5 text-right text-ink">
                        {row.exportacion.estado === 'dato'
                          ? `${row.exportacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 1 })} t`
                          : 'Sin datos'}
                      </td>
                      <td class="px-4 py-2.5 text-right text-ink-muted">
                        {row.importacion.estado === 'dato'
                          ? `${row.importacion.valor.toLocaleString('es-AR', { minimumFractionDigits: 1 })} t`
                          : 'Sin datos'}
                      </td>
                      <td class="py-2.5 pl-4 text-right text-ink-muted">
                        {row.saldo_comercial.estado === 'dato'
                          ? `${row.saldo_comercial.valor.toLocaleString('es-AR', { minimumFractionDigits: 1 })} t`
                          : 'Sin datos'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Sección 3: Empresa y planta verificables */}
    <section id="empresas" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Empresa predominante y complejo industrial
        </h2>
        <p class="mt-1.5 max-w-[70ch] text-[15px] text-ink-muted">
          Solo hechos verificables de los Estados Contables presentados ante la CNV y fichas
          corporativas oficiales.
        </p>
      </div>

      {empresaPrincipal && plantaPrincipal && (
        <div class="mt-8 border border-rule bg-stone-surface p-6">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="font-display text-[20px] font-semibold text-ink">
              {empresaPrincipal.razon_social}
            </h3>
            <span class="text-[13px] text-ink-muted">
              Capital {empresaPrincipal.tipo_capital}
            </span>
          </div>
          <p class="mt-2.5 max-w-[85ch] text-[15px] text-ink-muted">
            {empresaPrincipal.hechos_verificables}
          </p>

          <dl class="mt-6 grid gap-4 border-t border-rule pt-5 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
            <div>
              <dt class="text-[13px] text-ink-muted">Planta registrada</dt>
              <dd class="mt-0.5 text-[15px] font-semibold text-ink">{plantaPrincipal.nombre}</dd>
            </div>
            <div>
              <dt class="text-[13px] text-ink-muted">Localidad y coordenadas</dt>
              <dd class="mt-0.5 text-[15px] font-medium text-ink">
                {plantaPrincipal.localidad}, Buenos Aires ({plantaPrincipal.lat.toFixed(3)},{' '}
                {plantaPrincipal.lon.toFixed(3)})
              </dd>
            </div>
            <div>
              <dt class="text-[13px] text-ink-muted">Capacidad instalada</dt>
              <dd class="mt-0.5 text-[15px] font-semibold text-cobalt">
                {plantaPrincipal.capacidad.estado === 'dato'
                  ? `${plantaPrincipal.capacidad.valor.toLocaleString('es-AR')} ${plantaPrincipal.capacidad.unidad}`
                  : 'Sin datos'}
              </dd>
            </div>
            <div>
              <dt class="text-[13px] text-ink-muted">Insumo energético principal</dt>
              <dd class="mt-0.5 text-[15px] text-ink">Gas natural (hasta 2,5 M m3/día)</dd>
            </div>
          </dl>

          <p class="mt-5 border-t border-rule pt-4 text-[13px] text-ink-muted">
            Cita ({empresaPrincipal.procedencia.anio}): {empresaPrincipal.procedencia.cita_ubicacion}.{' '}
            {empresaPrincipal.sitio_web_oficial && (
              <a
                href={empresaPrincipal.sitio_web_oficial}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-cobalt hover:underline"
              >
                Sitio oficial ↗
              </a>
            )}
          </p>
        </div>
      )}
    </section>

    {/* Sección 4: Ensayo de ingeniería química (MDX) */}
    <section class="pt-16">
      <div class="border border-rule bg-stone-surface p-6 sm:p-8 lg:p-10">
        <div class="atlas-prose max-w-[74ch]">
          <UreaEssay />
        </div>
      </div>
    </section>

    {/* Sección 5: Registro auditable de fuentes y hashes SHA-256 */}
    <section id="fuentes" class="scroll-mt-20 pt-16">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[24px] font-bold tracking-tight text-ink">
          Registro de fuentes oficiales y verificación SHA-256
        </h2>
        <p class="mt-1.5 text-[15px] text-ink-muted">
          Todas las cifras de esta ficha remiten a {fuentesCitadas.length} fuentes primarias
          verificadas en Supabase y sincronizadas al snapshot estático.
        </p>
      </div>

      <div class="mt-6 overflow-x-auto border border-rule bg-stone-surface">
        <table class="w-full border-collapse text-left text-[13px]">
          <thead>
            <tr class="border-b border-rule bg-stone-subtle text-ink-muted">
              <th class="px-4 py-3 font-medium">Fuente</th>
              <th class="px-4 py-3 font-medium">Organismo</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Descarga</th>
              <th class="px-4 py-3 font-medium">Hash SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            {fuentesCitadas.map((f) => (
              <tr class="align-top">
                <td class="px-4 py-3">
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-cobalt hover:underline"
                  >
                    {f.nombre} ↗
                  </a>
                  {f.notas && <p class="mt-1 text-ink-muted">{f.notas}</p>}
                </td>
                <td class="px-4 py-3 text-ink">{f.organismo}</td>
                <td class="px-4 py-3 text-ink-muted">{TIPO_FUENTE_LABEL[f.tipo] ?? f.tipo}</td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">{f.fecha_descarga}</td>
                <td class="px-4 py-3 text-ink-muted tabular-nums">
                  <span title={f.hash}>{f.hash.slice(0, 22)}...</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="border-t border-rule bg-stone-surface">
    <div class="mx-auto flex max-w-[1600px] flex-wrap items-center justify-between gap-4 px-5 py-6 text-[13px] text-ink-muted sm:px-8 lg:px-10">
      <p>
        Atlas Químico Argentino. Ficha de urea granulada (Bahía Blanca) validada bajo política
        strictReal.
      </p>
      <div class="flex items-center gap-5">
        <a href="/productos/aluminio" class="hover:text-cobalt">Aluminio</a>
        <a href="/productos/litio" class="hover:text-cobalt">Litio</a>
        <a href="/" class="font-medium text-ink hover:text-cobalt">
          ← Volver al mapa productivo
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
