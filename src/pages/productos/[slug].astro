---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SiteHeader } from '@/components/SiteHeader';
import { AluarProcessAnatomy } from '@/components/AluarProcessAnatomy';
import { AlgodonProcessAnatomy } from '@/components/AlgodonProcessAnatomy';
import { MetanolProcessAnatomy } from '@/components/MetanolProcessAnatomy';
import { PolipropilenoProcessAnatomy } from '@/components/PolipropilenoProcessAnatomy';
import { BioetanolMaizProcessAnatomy } from '@/components/BioetanolMaizProcessAnatomy';
import { BioetanolCanaProcessAnatomy } from '@/components/BioetanolCanaProcessAnatomy';
import { SodaSolvayProcessAnatomy } from '@/components/SodaSolvayProcessAnatomy';
import { CalIndustrialProcessAnatomy } from '@/components/CalIndustrialProcessAnatomy';
import { OroPlataProcessAnatomy } from '@/components/OroPlataProcessAnatomy';
import { CelulosaKraftProcessAnatomy } from '@/components/CelulosaKraftProcessAnatomy';
import { GlpGasNaturalProcessAnatomy } from '@/components/GlpGasNaturalProcessAnatomy';
import { SalIndustrialProcessAnatomy } from '@/components/SalIndustrialProcessAnatomy';
import { CementoClinkerProcessAnatomy } from '@/components/CementoClinkerProcessAnatomy';
import { CitricosLimonenoProcessAnatomy } from '@/components/CitricosLimonenoProcessAnatomy';
import { ResinaColofoniaProcessAnatomy } from '@/components/ResinaColofoniaProcessAnatomy';
import { TaninoQuebrachoProcessAnatomy } from '@/components/TaninoQuebrachoProcessAnatomy';
import { AceiteOlivaProcessAnatomy } from '@/components/AceiteOlivaProcessAnatomy';
import { FarmoquimicaIfaProcessAnatomy } from '@/components/FarmoquimicaIfaProcessAnatomy';
import { GalvanizadoCalienteProcessAnatomy } from '@/components/GalvanizadoCalienteProcessAnatomy';
import { StandaloneCompanyMarket } from '@/components/CompanyMarketCard';
import { ProcessFlowDiagram } from '@/components/ProcessFlowDiagram';
import { ProductIcon } from '@/components/ProductIcon';
import {
  getFichaProducto,
  getMercadoSnapshot,
  getProductos,
  getSearchIndex,
} from '@/data';
import { buildProductPageView } from '@/data/productPageConfig';

export async function getStaticPaths() {
  const entries = await getCollection('productos');
  const entryById = new Map(entries.map((e) => [e.id, e]));
  return getProductos().map((producto) => ({
    params: { slug: producto.producto_id },
    props: { mdxEntry: entryById.get(producto.producto_id) ?? null },
  }));
}

const { slug } = Astro.params;
const { mdxEntry } = Astro.props;
const ficha = slug ? getFichaProducto(slug) : undefined;
if (!ficha) {
  throw new Error(`No se encontró la ficha del producto "${slug}" en la capa de datos.`);
}

const procesoPrincipal = ficha.procesos[0];
if (!procesoPrincipal) {
  throw new Error(`No se encontró el proceso principal de "${slug}".`);
}

const searchItems = getSearchIndex();
const mercadoSnapshot = getMercadoSnapshot();
const view = buildProductPageView(ficha);

const RenderedEssay = mdxEntry ? (await render(mdxEntry)).Content : null;

const produccionDatos = ficha.produccion
  .filter((r) => r.medicion.estado === 'dato')
  .sort((a, b) => b.anio - a.anio);

// Agrupar series de producción por jurisdicción (provincial vs total país) para barras comparables
const provMap = new Map(ficha.zonas.map((z) => [z.provincia_id, z.provincia.nombre]));
const prodGroupsMap = new Map<string, typeof produccionDatos>();
for (const reg of produccionDatos) {
  const key = reg.provincia_id
    ? `${provMap.get(reg.provincia_id) ?? `Prov. ${reg.provincia_id}`} (${reg.medicion.estado === 'dato' ? reg.medicion.unidad : ''})`
    : `Total nacional (${reg.medicion.estado === 'dato' ? reg.medicion.unidad : ''})`;
  const list = prodGroupsMap.get(key) ?? [];
  list.push(reg);
  prodGroupsMap.set(key, list);
}
const prodGroups = Array.from(prodGroupsMap.entries());

const comexUsd = ficha.comercioExterior
  .filter((r) => r.metrica === 'valor_usd')
  .sort((a, b) => b.anio - a.anio || (a.ncm_codigo ?? '').localeCompare(b.ncm_codigo ?? ''));

const comexVol = ficha.comercioExterior
  .filter((r) => r.metrica === 'volumen_t')
  .sort((a, b) => b.anio - a.anio || (a.ncm_codigo ?? '').localeCompare(b.ncm_codigo ?? ''));

// Métricas auxiliares para los wrappers 3D que muestran cifras al pie
const ultimaProdVal =
  produccionDatos[0]?.medicion.estado === 'dato' ? produccionDatos[0].medicion.valor : null;
const aluminaVolVal = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '2818.20');
  return r?.importacion.estado === 'dato' ? r.importacion.valor : null;
})();
const energiaPrincipalVal =
  procesoPrincipal.proceso.energia_especifica.estado === 'dato'
    ? procesoPrincipal.proceso.energia_especifica.valor
    : null;
const prodChacoVal = (() => {
  const r = produccionDatos.find((x) => x.provincia_id === '22');
  return r?.medicion.estado === 'dato' ? r.medicion.valor : null;
})();
const expFibraVal = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '5201.00');
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const maizCordobaVal = (() => {
  const r = produccionDatos.find((x) => x.provincia_id === '14');
  return r?.medicion.estado === 'dato' ? r.medicion.valor : null;
})();
const etanolNacionalM3 = (() => {
  const r = produccionDatos.find((x) => x.provincia_id === null);
  return r?.medicion.estado === 'dato' ? r.medicion.valor : null;
})();
const expAzucarVol2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '1701.99' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const expMetanolVol2023T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '2905.11' && x.anio === 2023);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const ultimoComexVolExp =
  comexVol[0]?.exportacion.estado === 'dato' ? comexVol[0].exportacion.valor : null;
const ultimoComexVolImp =
  comexVol[0]?.importacion.estado === 'dato' ? comexVol[0].importacion.valor : null;
const sodaImp2024UsdM = (() => {
  const r = comexUsd.find((x) => x.ncm_codigo === '2836.20' && x.anio === 2024);
  return r?.importacion.estado === 'dato' ? r.importacion.valor : null;
})();
const oroExp2024UsdM = (() => {
  const r = comexUsd.find((x) => x.ncm_codigo === '7108.12' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const glpPropanoExp2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '2711.12' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const jugoNaranjaExp2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '2009.11' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const colofoniaExp2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '3806.10' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const quebrachoExp2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '3201.10' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const olivaExp2024T = (() => {
  const r = comexVol.find((x) => x.ncm_codigo === '1509.20' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const farmaExp2024UsdM = (() => {
  const r = comexUsd.find((x) => x.ncm_codigo === '3004.90' && x.anio === 2024);
  return r?.exportacion.estado === 'dato' ? r.exportacion.valor : null;
})();
const zincImp2024UsdM = (() => {
  const r = comexUsd.find((x) => x.ncm_codigo === '7901.11' && x.anio === 2024);
  return r?.importacion.estado === 'dato' ? r.importacion.valor : null;
})();

const mercadoEmpresaIds = new Set(mercadoSnapshot.empresas.map((m) => m.empresa_id));

const TIPO_FUENTE_LABEL: Record<string, string> = {
  oficial: 'Oficial',
  tecnica: 'Técnica internacional',
  empresa: 'Empresa (oficial / CNV)',
  ejemplo: 'Ejemplo',
};

const ESTADO_PLANTA_LABEL: Record<string, string> = {
  operativa: 'Operativa',
  ampliacion: 'En ampliación',
  en_construccion: 'En construcción',
  inactiva: 'Inactiva',
  sin_datos: 'Sin datos',
};
---

<BaseLayout title={view.seoTitle} description={view.seoDescription}>
  <SiteHeader
    client:idle
    variant="solid"
    searchItems={searchItems}
    currentPath={`/productos/${ficha.producto.producto_id}`}
  />

  <main class="mx-auto max-w-[1600px] px-5 pb-20 pt-6 sm:px-8 lg:px-10">
    <nav
      aria-label="Secciones de la ficha"
      class="mb-7 flex flex-wrap items-center justify-between gap-3 border-b border-rule pb-3 text-[13px] text-ink-muted"
    >
      <a href="/#mapa" class="font-medium text-ink transition-colors duration-150 hover:text-cobalt">
        ← Volver al mapa territorial
      </a>
      <div class="flex flex-wrap items-center gap-4">
        {view.anatomy && (
          <a href="#anatomia" class="transition-colors duration-150 hover:text-ink">Planta 3D</a>
        )}
        <a href="#diagrama" class="transition-colors duration-150 hover:text-ink">Diagrama PFD</a>
        <a href="#datos" class="transition-colors duration-150 hover:text-ink">Producción y comercio</a>
        <a href="#empresas" class="transition-colors duration-150 hover:text-ink tabular-nums">
          Plantas ({ficha.plantas.length})
        </a>
        <a href="#fuentes" class="transition-colors duration-150 hover:text-ink tabular-nums">
          Fuentes ({ficha.fuentesCitadas.length})
        </a>
      </div>
    </nav>

    {/* Cabecera de la cadena productiva */}
    <section class="border-b border-rule pb-8">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <div class="flex items-start gap-4">
          <span
            class={`mt-1 flex h-12 w-12 shrink-0 items-center justify-center text-white ${view.badgeBgClass}`}
          >
            <ProductIcon iconId={ficha.producto.icono_id} size={24} />
          </span>
          <div>
            <div class="flex flex-wrap items-baseline gap-3">
              <h1 class="font-display text-[clamp(1.85rem,3vw,2.6rem)] font-medium leading-[1.06] tracking-[-0.032em] text-ink">
                {ficha.producto.nombre}
              </h1>
              {ficha.producto.formula_quimica && (
                <span class={`font-display text-[19px] font-medium tabular-nums ${view.formulaTextClass}`}>
                  {ficha.producto.formula_quimica}
                </span>
              )}
            </div>
            <p class="mt-2 max-w-[68ch] text-[15px] text-ink-muted">
              {ficha.producto.descripcion_corta}
            </p>
            <p class="mt-2 text-[13px] text-ink-muted tabular-nums">
              Jurisdicción: {view.jurisdiccionLine}
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-[13px] font-medium text-ink">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-react" />
          <span>Cadena verificada · Trazabilidad SHA-256</span>
        </div>
      </div>

      <dl class="mt-8 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 lg:grid-cols-4 tabular-nums">
        {view.kpis.map((kpi) => (
          <div>
            <dt class="text-[13px] text-ink-muted">{kpi.label}</dt>
            <dd
              class={`mt-1 font-display text-[24px] font-medium leading-tight tracking-[-0.02em] ${kpi.valueClass ?? 'text-ink'}`}
            >
              {kpi.value}
            </dd>
            <p class="mt-1 text-[13px] text-ink-muted">{kpi.sublabel}</p>
          </div>
        ))}
      </dl>
    </section>

    {/* Boceto 3D interactivo estilo Inkworks-Atlas (solo cuando el producto tiene mecanismo 3D) */}
    {view.anatomy && (
      <section id="anatomia" class="scroll-mt-24 pt-16">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-3xl">
            <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
              {view.anatomy.title}
            </h2>
            <p class="mt-1.5 text-[15px] text-ink-muted">{view.anatomy.description}</p>
          </div>
          <p class="text-[13px] text-ink-muted tabular-nums">{view.anatomy.hint}</p>
        </div>

        {slug === 'aluminio' && (
          <AluarProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            produccionLiquidaT={ultimaProdVal}
            aluminaImportadaT={aluminaVolVal}
            energiaElectrolisisMwhT={energiaPrincipalVal}
          />
        )}
        {slug === 'algodon' && (
          <AlgodonProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            produccionChacoT={prodChacoVal}
            exportacionFibraT={expFibraVal}
          />
        )}
        {slug === 'metanol' && (
          <MetanolProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportVol2023T={expMetanolVol2023T}
          />
        )}
        {slug === 'polipropileno' && (
          <PolipropilenoProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportVol2024T={ultimoComexVolExp}
          />
        )}
        {slug === 'bioetanol-maiz' && (
          <BioetanolMaizProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            maizCordobaT={maizCordobaVal}
            bioetanolPaisM3={etanolNacionalM3}
          />
        )}
        {slug === 'bioetanol-cana' && (
          <BioetanolCanaProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            bioetanolCanaM3={etanolNacionalM3}
            azucarExp2024T={expAzucarVol2024T}
          />
        )}
        {slug === 'soda-solvay' && (
          <SodaSolvayProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            importUsd2024M={sodaImp2024UsdM}
          />
        )}
        {slug === 'cal-industrial' && (
          <CalIndustrialProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportVol2024T={ultimoComexVolExp}
          />
        )}
        {slug === 'oro-plata' && (
          <OroPlataProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            prodPlata2024T={ultimaProdVal}
            exportOro2024UsdM={oroExp2024UsdM}
          />
        )}
        {slug === 'celulosa-kraft' && (
          <CelulosaKraftProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            importVol2024T={ultimoComexVolImp}
          />
        )}
        {slug === 'glp-gas-natural' && (
          <GlpGasNaturalProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportPropano2024T={glpPropanoExp2024T}
          />
        )}
        {slug === 'sal-industrial' && (
          <SalIndustrialProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportVol2024T={ultimoComexVolExp}
          />
        )}
        {slug === 'cemento-clinker' && (
          <CementoClinkerProcessAnatomy client:visible={{ rootMargin: '250px' }} pasos={procesoPrincipal.pasos} />
        )}
        {slug === 'citricos-limoneno' && (
          <CitricosLimonenoProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportJugo2024T={jugoNaranjaExp2024T}
          />
        )}
        {slug === 'resina-colofonia' && (
          <ResinaColofoniaProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportColofonia2024T={colofoniaExp2024T}
          />
        )}
        {slug === 'tanino-quebracho' && (
          <TaninoQuebrachoProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportQuebracho2024T={quebrachoExp2024T}
          />
        )}
        {slug === 'aceite-oliva' && (
          <AceiteOlivaProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportOliva2024T={olivaExp2024T}
          />
        )}
        {slug === 'farmoquimica-ifa' && (
          <FarmoquimicaIfaProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            exportFarma2024UsdM={farmaExp2024UsdM}
          />
        )}
        {slug === 'galvanizado-caliente' && (
          <GalvanizadoCalienteProcessAnatomy
            client:visible={{ rootMargin: '250px' }}
            pasos={procesoPrincipal.pasos}
            importZinc2024UsdM={zincImp2024UsdM}
          />
        )}
      </section>
    )}

    {/* Diagrama PFD ISO 10628 + Grafo interactivo (soporta selector multi-ruta automático) */}
    <section id="diagrama" class="scroll-mt-24 pt-20">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl">
          <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
            {view.diagramTitle}
          </h2>
          <p class="mt-1.5 text-[15px] text-ink-muted">{view.diagramDescription}</p>
        </div>
        {view.diagramBadge && (
          <p class="text-[13px] text-ink-muted tabular-nums">
            {view.diagramBadge.label}:{' '}
            <strong class="font-medium text-ink">{view.diagramBadge.strong}</strong>
          </p>
        )}
      </div>

      {ficha.procesos.length > 1 ? (
        <ProcessFlowDiagram
          client:visible={{ rootMargin: '300px' }}
          procesos={ficha.procesos}
          procesoMetaById={view.procesoMetaById}
        />
      ) : (
        <ProcessFlowDiagram client:visible={{ rootMargin: '300px' }} procesoCompleto={procesoPrincipal} />
      )}
    </section>

    {/* Producción física y comercio exterior verificados */}
    <section id="datos" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Producción física y comercio exterior verificados
        </h2>
        <p class="mt-1.5 max-w-[70ch] text-[15px] text-ink-muted">
          Registros oficiales verificados con hash SHA-256. Donde no existen series públicas
          auditadas se declara explícitamente sin datos.
        </p>
      </div>

      <div class="mt-8 grid gap-8 lg:grid-cols-12">
        {/* Columna izquierda: Series de producción o estado explícito sin_datos */}
        <div class="space-y-6 lg:col-span-5">
          {prodGroups.length > 0 ? (
            prodGroups.map(([groupLabel, rows]) => {
              const maxVal = Math.max(
                ...rows.map((r) => (r.medicion.estado === 'dato' ? r.medicion.valor : 0)),
                1
              );
              const sampleFuente = rows[0]?.procedencia;
              return (
                <div class="border border-rule bg-stone-surface p-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="font-display text-[17px] font-medium text-ink">{groupLabel}</h3>
                    <span class="text-[12px] text-ink-muted">{rows.length} períodos</span>
                  </div>
                  {sampleFuente && (
                    <p class="mt-1 text-[13px] text-ink-muted">Fuente: {sampleFuente.fuente}</p>
                  )}
                  <div class="mt-5 space-y-3.5 tabular-nums">
                    {rows.map((reg) => {
                      const val = reg.medicion.estado === 'dato' ? reg.medicion.valor : 0;
                      const unidad = reg.medicion.estado === 'dato' ? reg.medicion.unidad : '';
                      const pct = (val / maxVal) * 100;
                      return (
                        <div>
                          <div class="flex items-baseline justify-between text-[14px]">
                            <span class="font-medium text-ink">{reg.anio}</span>
                            <span class="font-medium text-ink">
                              {val.toLocaleString('es-AR')} {unidad}
                            </span>
                          </div>
                          <div class="mt-1.5 h-2 w-full bg-stone-subtle">
                            <div
                              class={`h-full ${view.badgeBgClass}`}
                              style={{ width: `${pct.toFixed(1)}%` }}
                            />
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })
          ) : (
            <div class="border border-rule bg-stone-surface p-6">
              <h3 class="font-display text-[17px] font-medium text-ink">
                Auditoría de producción física
              </h3>
              <p class="mt-2 text-[14px] text-ink-muted">
                Estado actual:{' '}
                <strong class="font-medium text-ink">Sin datos públicos auditados</strong>.
              </p>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-muted">
                {view.sinDatosProduccionExplicacion ??
                  'No figura una serie anual abierta y auditada para esta jurisdicción o producto en organismos oficiales primarios. Nunca completamos con estimaciones propias.'}
              </p>
            </div>
          )}
        </div>

        {/* Columna derecha: Comercio exterior monetario y físico */}
        <div class="space-y-6 lg:col-span-7">
          {comexUsd.length > 0 && (
            <div class="border border-rule bg-stone-surface p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-[17px] font-medium text-ink">
                  Comercio exterior en valor (millones USD)
                </h3>
                <span class="text-[13px] text-ink-muted">INDEC / UN Comtrade</span>
              </div>
              <div class="mt-4 overflow-x-auto">
                <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                  <thead>
                    <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                      <th class="py-2.5 pr-4 font-medium">Partida NCM / HS</th>
                      <th class="px-3 py-2.5 font-medium">Año</th>
                      <th class="px-3 py-2.5 text-right font-medium">Exp. (USD M)</th>
                      <th class="px-3 py-2.5 text-right font-medium">Imp. (USD M)</th>
                      <th class="py-2.5 pl-3 text-right font-medium">Saldo (USD M)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-rule">
                    {comexUsd.map((row) => (
                      <tr>
                        <td class="py-2.5 pr-4 font-medium text-ink">
                          {row.ncm_codigo
                            ? (view.ncmLabels[row.ncm_codigo] ?? `HS ${row.ncm_codigo}`)
                            : ficha.producto.nombre}
                        </td>
                        <td class="px-3 py-2.5 text-ink-muted">{row.anio}</td>
                        <td class="px-3 py-2.5 text-right text-ink">
                          {row.exportacion.estado === 'dato'
                            ? row.exportacion.valor.toLocaleString('es-AR', {
                                minimumFractionDigits: 2,
                              })
                            : 'Sin datos'}
                        </td>
                        <td class="px-3 py-2.5 text-right text-ink-muted">
                          {row.importacion.estado === 'dato'
                            ? row.importacion.valor.toLocaleString('es-AR', {
                                minimumFractionDigits: 2,
                              })
                            : 'Sin datos'}
                        </td>
                        <td
                          class={`py-2.5 pl-3 text-right font-medium ${
                            row.saldo_comercial.estado === 'dato' && row.saldo_comercial.valor < 0
                              ? 'text-signal-red'
                              : 'text-emerald-react'
                          }`}
                        >
                          {row.saldo_comercial.estado === 'dato'
                            ? `${row.saldo_comercial.valor >= 0 ? '+' : ''}${row.saldo_comercial.valor.toLocaleString('es-AR', { minimumFractionDigits: 2 })}`
                            : 'Sin datos'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {comexVol.length > 0 && (
            <div class="border border-rule bg-stone-surface p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-display text-[17px] font-medium text-ink">
                  Volúmenes físicos aduaneros (toneladas)
                </h3>
                <span class="text-[13px] text-ink-muted">UN Comtrade</span>
              </div>
              <div class="mt-4 overflow-x-auto">
                <table class="w-full border-collapse text-left text-[14px] tabular-nums">
                  <thead>
                    <tr class="border-b border-rule-strong/30 text-[13px] text-ink-muted">
                      <th class="py-2.5 pr-4 font-medium">Partida NCM / HS</th>
                      <th class="px-3 py-2.5 font-medium">Año</th>
                      <th class="px-3 py-2.5 text-right font-medium">Exportación</th>
                      <th class="py-2.5 pl-3 text-right font-medium">Importación</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-rule">
                    {comexVol.map((row) => (
                      <tr>
                        <td class="py-2.5 pr-4 font-medium text-ink">
                          {row.ncm_codigo
                            ? (view.ncmLabels[row.ncm_codigo] ?? `HS ${row.ncm_codigo}`)
                            : ficha.producto.nombre}
                        </td>
                        <td class="px-3 py-2.5 text-ink-muted">{row.anio}</td>
                        <td class="px-3 py-2.5 text-right text-cobalt">
                          {row.exportacion.estado === 'dato'
                            ? `${Math.round(row.exportacion.valor).toLocaleString('es-AR')} t`
                            : 'Sin datos'}
                        </td>
                        <td class="py-2.5 pl-3 text-right text-ink">
                          {row.importacion.estado === 'dato'
                            ? `${Math.round(row.importacion.valor).toLocaleString('es-AR')} t`
                            : 'Sin datos'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    {/* Plantas georreferenciadas y valuación bursátil cuando aplica */}
    <section id="empresas" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Plantas industriales y empresas operadoras ({ficha.plantas.length})
        </h2>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {ficha.plantas.map((pl) => (
          <article class="flex flex-col justify-between border border-rule bg-stone-surface p-6">
            <div>
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="font-display text-[18px] font-medium text-ink">{pl.nombre}</h3>
                  <p class="mt-1 text-[13px] text-ink-muted tabular-nums">
                    {pl.localidad}
                    {pl.provincia ? `, ${pl.provincia.nombre}` : ''} · Coord. {pl.lat.toFixed(3)},{' '}
                    {pl.lon.toFixed(3)}
                  </p>
                </div>
                <span class="border border-rule bg-stone-bg px-2.5 py-1 text-[12px] font-medium text-ink">
                  {ESTADO_PLANTA_LABEL[pl.estado_operativo] ?? pl.estado_operativo}
                </span>
              </div>

              {pl.capacidad.estado === 'dato' && (
                <p class="mt-3 text-[13px] font-medium text-cobalt tabular-nums">
                  Capacidad declarada: {pl.capacidad.valor.toLocaleString('es-AR')}{' '}
                  {pl.capacidad.unidad}
                </p>
              )}

              {pl.empresa && (
                <div class="mt-3 border-t border-rule pt-3">
                  <p class="text-[14px] font-medium text-ink">{pl.empresa.razon_social}</p>
                  <p class="mt-1.5 text-[14px] leading-relaxed text-ink-muted">
                    {pl.empresa.hechos_verificables}
                  </p>
                </div>
              )}

              {pl.empresa && mercadoEmpresaIds.has(pl.empresa.empresa_id) && (
                <StandaloneCompanyMarket
                  client:visible
                  empresaId={pl.empresa.empresa_id}
                  initialSnapshot={mercadoSnapshot}
                />
              )}
            </div>

            <p class="mt-5 border-t border-rule pt-3 text-[12px] text-ink-muted">
              Cita ({pl.procedencia.anio}): {pl.procedencia.cita_ubicacion}
              {pl.empresa?.sitio_web_oficial && (
                <>
                  {' · '}
                  <a
                    href={pl.empresa.sitio_web_oficial}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-cobalt hover:underline"
                  >
                    Sitio oficial ↗
                  </a>
                </>
              )}
            </p>
          </article>
        ))}
      </div>
    </section>

    {/* Ensayo técnico MDX cuando existe en src/content/productos/<slug>.mdx */}
    {RenderedEssay && (
      <section class="pt-20">
        <div class="border border-rule bg-stone-surface p-6 sm:p-8 lg:p-10">
          <div class="atlas-prose max-w-[74ch]">
            <RenderedEssay />
          </div>
        </div>
      </section>
    )}

    {/* Registro auditable de fuentes primarias con SHA-256 */}
    <section id="fuentes" class="scroll-mt-24 pt-20">
      <div class="border-b border-rule pb-4">
        <h2 class="font-display text-[23px] font-medium leading-[1.15] tracking-[-0.022em] text-ink">
          Registro de fuentes primarias y verificación SHA-256 ({ficha.fuentesCitadas.length})
        </h2>
        <p class="mt-1.5 text-[15px] text-ink-muted">
          Cada cifra, equipo y corriente de esta ficha remite a una fuente verificada con huella
          criptográfica.
        </p>
      </div>

      <div class="mt-6 overflow-x-auto border border-rule bg-stone-surface">
        <table class="w-full border-collapse text-left text-[13px] tabular-nums">
          <thead>
            <tr class="border-b border-rule bg-stone-subtle text-ink-muted">
              <th class="px-4 py-3 font-medium">Fuente</th>
              <th class="px-4 py-3 font-medium">Organismo</th>
              <th class="px-4 py-3 font-medium">Tipo</th>
              <th class="px-4 py-3 font-medium">Descarga</th>
              <th class="px-4 py-3 font-medium">Hash SHA-256</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rule">
            {ficha.fuentesCitadas.map((f) => (
              <tr class="align-top">
                <td class="px-4 py-3">
                  <a
                    href={f.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-medium text-cobalt hover:underline"
                  >
                    {f.nombre} ↗
                  </a>
                  {f.notas && <p class="mt-1 text-ink-muted">{f.notas}</p>}
                </td>
                <td class="px-4 py-3 text-ink">{f.organismo}</td>
                <td class="px-4 py-3 text-ink-muted">{TIPO_FUENTE_LABEL[f.tipo] ?? f.tipo}</td>
                <td class="px-4 py-3 text-ink-muted">{f.fecha_descarga}</td>
                <td class="px-4 py-3 font-mono text-[12px] text-ink-muted" title={f.hash}>
                  {f.hash.slice(0, 23)}...
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
